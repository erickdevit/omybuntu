#!/bin/bash

# omybuntu:summary=Toggle notification do-not-disturb mode

makoctl mode -t do-not-disturb

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

if makoctl mode | grep -q 'do-not-disturb'; then
  omybuntu-notification-send -g 󰂛 "$I18N_TOG_NOTIFS_SILENT"
else
  omybuntu-notification-send -g 󰂚 "$I18N_TOG_NOTIFS_ENABLED"
fi

pkill -RTMIN+10 waybar
