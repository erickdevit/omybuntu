#!/bin/bash

# omybuntu:summary=Enable, disable, toggle, or recover the internal laptop display
# omybuntu:args=<on|off|toggle|recover>

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

TOGGLE="internal-monitor-disable"
TOGGLE_FLAG="$HOME/.local/state/omybuntu/toggles/hypr/$TOGGLE.lua"
MIRROR_TOGGLE="internal-monitor-mirror"

# Get internal monitor name dynamically
INTERNAL=$(hyprctl monitors -j | jq -r '.[] | select(.name | contains("eDP")).name' | head -n 1)

on() {
  if omybuntu-hyprland-toggle-enabled $TOGGLE; then
    omybuntu-hyprland-toggle $TOGGLE off
    omybuntu-notification-send -g 󰍹 "$I18N_MON_INTERNAL_ENABLED"
  fi
}

off() {
  if ! omybuntu-hw-external-monitors; then
    omybuntu-notification-send -g 󰍹 "$I18N_MON_INTERNAL_CANT_DISABLE"
    exit 1
  fi

  if omybuntu-hyprland-toggle-disabled $TOGGLE && omybuntu-hyprland-toggle-disabled $MIRROR_TOGGLE; then
    printf 'hl.monitor({ output = "%s", disabled = true })\n' "$INTERNAL" >"$TOGGLE_FLAG"
    omybuntu-notification-send -g 󰍹 "$I18N_MON_INTERNAL_DISABLED"
    hyprctl reload
  fi
}

recover() {
  if ! omybuntu-hw-external-monitors && omybuntu-hyprland-toggle-enabled $TOGGLE; then
    omybuntu-hyprland-toggle $TOGGLE off
  fi
}

toggle() {
  if omybuntu-hyprland-toggle-enabled $TOGGLE; then
    on
  else
    off
  fi
}

case "$1" in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
