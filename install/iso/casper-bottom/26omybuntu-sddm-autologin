#!/bin/sh

PREREQ=""
DESCRIPTION="Finalizing Omybuntu SDDM autologin for the live session"

prereqs()
{
  echo "$PREREQ"
}

case $1 in
prereqs)
  prereqs
  exit 0
  ;;
esac

. /scripts/casper-functions

log_begin_msg "$DESCRIPTION"

if [ ! -f /root/usr/bin/sddm ]; then
  log_end_msg
  exit 0
fi

if [ ! -f /root/usr/share/wayland-sessions/omybuntu.desktop ]; then
  log_end_msg
  exit 0
fi

live_user="${USERNAME:-omybuntu}"

if [ -f /root/etc/sddm.conf ]; then
  sed -i '/^\[Autologin\]/,/^$/d' /root/etc/sddm.conf
fi

rm -f /root/etc/sddm.conf.d/autologin.conf
rm -f /root/etc/sddm.conf.d/50-ubuntu-budgie.conf
rm -f /root/etc/sddm.conf.d/99-omybuntu.conf

cat >/root/etc/sddm.conf.d/zz-omybuntu-live.conf <<EOF
[General]
DisplayServer=wayland
DefaultSession=omybuntu

[Wayland]
CompositorCommand=start-hyprland -- --config /usr/share/sddm/hyprland.conf

[Autologin]
User=$live_user
Session=omybuntu
Relogin=true

[Theme]
Current=omybuntu
EOF

if [ -f /root/etc/pam.d/sddm-autologin ]; then
  sed -i '/pam_faillock\.so/d' /root/etc/pam.d/sddm-autologin
fi

if [ -n "$live_user" ]; then
  chroot /root passwd -d "$live_user" >/dev/null 2>&1 || true
  for group in adm cdrom sudo dip plugdev users lpadmin video input render netdev; do
    if chroot /root getent group "$group" >/dev/null 2>&1; then
      chroot /root usermod -aG "$group" "$live_user" >/dev/null 2>&1 || true
    fi
  done
  chroot /root chown -R "$live_user:$live_user" "/home/$live_user" >/dev/null 2>&1 || true
fi

log_end_msg
