#!/bin/bash

# omybuntu:summary=Shut down after closing application windows
# omybuntu:examples=omybuntu shutdown | omybuntu system shutdown
# omybuntu:aliases=omybuntu shutdown

omybuntu-state clear re*-required

# Schedule the shutdown to happen after closing windows (detached from terminal)
nohup bash -c "sleep 2 && systemctl poweroff --no-wall" >/dev/null 2>&1 &

# Now close all windows
omybuntu-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
