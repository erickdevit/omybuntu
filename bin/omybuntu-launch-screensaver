#!/bin/bash

# omybuntu:summary=Launch the Omybuntu screensaver in the default terminal on the system with the correct font configuration.

OMYBUNTU_PATH="${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}"
export PATH="$OMYBUNTU_PATH/bin:$PATH"

if ! command -v tte &>/dev/null; then
  exit 1
fi

# Exit early if screensave is already running
pgrep -f org.omybuntu.screensaver && exit 0

# Allow screensaver to be turned off but also force started
if omybuntu-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
  exit 1
fi

# Silently quit Walker on overlay
command -v walker &>/dev/null && walker -q

focused=$(omybuntu-hyprland-monitor-focused)
terminal=$(xdg-terminal-exec --print-id)

hypr_focus_monitor() {
  local res
  if ! res=$(hyprctl dispatch "hl.dsp.focus({ monitor = \"$1\" })" 2>&1) || [[ $res == *"Invalid dispatcher"* ]]; then
    hyprctl dispatch focusmonitor "$1" >/dev/null
  fi
}

hypr_exec() {
  local command="$1"
  local res
  if ! res=$(hyprctl dispatch "hl.dsp.exec_cmd([[$command]])" 2>&1) || [[ $res == *"Invalid dispatcher"* ]]; then
    hyprctl dispatch exec -- bash -lc "$command" >/dev/null
  fi
}

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hypr_focus_monitor "$m"

  case $terminal in
  *Alacritty*)
    hypr_exec "alacritty --class=org.omybuntu.screensaver --config-file ~/.local/share/omybuntu/default/alacritty/screensaver.toml -e \"$OMYBUNTU_PATH/bin/omybuntu-screensaver\""
    ;;
  *ghostty*)
    hypr_exec "ghostty --class=org.omybuntu.screensaver --config-file=~/.local/share/omybuntu/default/ghostty/screensaver --font-size=18 -e \"$OMYBUNTU_PATH/bin/omybuntu-screensaver\""
    ;;
  *foot*)
    hypr_exec "foot --app-id=org.omybuntu.screensaver --config=\"$OMYBUNTU_PATH/default/foot/screensaver.ini\" -e \"$OMYBUNTU_PATH/bin/omybuntu-screensaver\""
    ;;
  *kitty*)
    hypr_exec "kitty --class=org.omybuntu.screensaver --override font_size=18 --override window_padding_width=0 -e \"$OMYBUNTU_PATH/bin/omybuntu-screensaver\""
    ;;
  *)
    notify-send -u low "✋  Screensaver only runs in Alacritty, Foot, Ghostty, or Kitty"
    ;;
  esac
done

hypr_focus_monitor "$focused"
