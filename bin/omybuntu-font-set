#!/bin/bash

# omybuntu:summary=Set the system monospace font
# omybuntu:args=<font-name>
# omybuntu:examples=omybuntu font list | omybuntu font set "CaskaydiaMono Nerd Font"

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

font_name="$1"


if [[ -n $font_name ]]; then
  if fc-list | grep -iq "$font_name"; then
    if [[ -f ~/.config/alacritty/alacritty.toml ]]; then
      sed -i "s/family = \".*\"/family = \"$font_name\"/g" ~/.config/alacritty/alacritty.toml
    fi

    if [[ -f ~/.config/kitty/kitty.conf ]]; then
      sed -i "s/^font_family .*/font_family $font_name/g" ~/.config/kitty/kitty.conf
      pkill -USR1 kitty
    fi

    if [[ -f ~/.config/ghostty/config ]]; then
      sed -i "s/font-family = \".*\"/font-family = \"$font_name\"/g" ~/.config/ghostty/config
      pkill -SIGUSR2 ghostty
    fi

    if [[ -f ~/.config/foot/foot.ini ]]; then
      sed -i "s/^font=.*/font=$font_name:size=9/g" ~/.config/foot/foot.ini
    fi

    sed -i "s/font_family = .*/font_family = $font_name/g" ~/.config/hypr/hyprlock.conf
    sed -i "s/font-family: .*/font-family: '$font_name';/g" ~/.config/waybar/style.css
    sed -i "s/font-family: .*/font-family: '$font_name';/g" ~/.config/swayosd/style.css
    xmlstarlet ed -L \
      -u '//match[@target="pattern"][test/string="monospace"]/edit[@name="family"]/string' \
      -v "$font_name" \
      ~/.config/fontconfig/fonts.conf

    omybuntu-restart-waybar
    omybuntu-restart-swayosd

    if pgrep -x ghostty; then
      omybuntu-notification-send -g  "$I18N_FONT_RESTART_GHOSTTY"
    fi

    if pgrep -x foot; then
      omybuntu-notification-send -g  "$I18N_FONT_RESTART_FOOT"
    fi

    omybuntu-hook font-set "$font_name"
  else
    echo "Font '$font_name' not found."
    exit 1
  fi
else
  echo "Usage: omybuntu-font-set <font-name>"
fi
