#!/bin/bash

# omybuntu:summary=Install Zed Editor and configure it with the current Omybuntu theme

echo "Installing Zed Editor..."
curl -f https://zed.dev/install.sh | sh

# Configure Zed settings
mkdir -p ~/.config/zed
if [[ ! -f ~/.config/zed/settings.json ]]; then
  echo -e '{\n  "theme": "One Dark"\n}' > ~/.config/zed/settings.json
fi

# Launch Zed Editor
if [[ -f ~/.local/bin/zed ]]; then
  setsid ~/.local/bin/zed &>/dev/null &
else
  setsid zed &>/dev/null &
fi
