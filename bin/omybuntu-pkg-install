#!/bin/bash

# omybuntu:summary=Show a fuzzy-finder TUI for picking new Apt packages to install.
# omybuntu:requires-sudo=true

set -euo pipefail
trap 'echo -e "\n❌ Error: Installation failed at line $LINENO." >&2' ERR

fzf_args=(
  --multi
  --preview 'apt-cache show {1} 2>/dev/null || echo "No preview available"'
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:green,marker:green'
)

pkg_names=$(apt-cache pkgnames | sort | fzf "${fzf_args[@]}" || true)

if [[ -n $pkg_names ]]; then
  source omybuntu-sudo-keepalive

  # Pass selections to omybuntu-pkg-add
  echo "$pkg_names" | xargs omybuntu-pkg-add
  omybuntu-show-done
  echo "✅ Success: Packages installed."
fi
