#!/bin/bash

# omybuntu:summary=Install a supported development environment
# omybuntu:name=dev-env
# omybuntu:args=<ruby|node|bun|deno|go|laravel|symfony|php|python|elixir|phoenix|rust|java|zig|ocaml|dotnet|clojure|scala>
# omybuntu:examples=omybuntu install dev-env ruby | omybuntu install dev-env node
# omybuntu:requires-sudo=true

set -euo pipefail
trap 'echo -e "\n❌ Error: Installation failed at line $LINENO." >&2' ERR

if [[ -z $1 ]]; then
  echo "Usage: omybuntu-install-dev-env <ruby|node|bun|deno|go|laravel|symfony|php|python|elixir|phoenix|rust|java|zig|ocaml|dotnet|clojure|scala>" >&2
  exit 1
fi

install_php() {
  omybuntu-pkg-add php php-cli composer php-sqlite3 php-xdebug php-bcmath php-intl php-mysql php-curl php-xml php-mbstring

  # Install Path for Composer
  if [[ :$PATH: != *:$HOME/.config/composer/vendor/bin:* ]]; then
    echo 'export PATH="$HOME/.config/composer/vendor/bin:$PATH"' >>"$HOME/.bashrc"
    source "$HOME/.bashrc"
    echo "Added Composer global bin directory to PATH."
  else
    echo "Composer global bin directory already in PATH."
  fi

  # Configure Xdebug for debugging
  local php_version
  php_version=$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null || echo "8.3")
  local xdebug_ini="/etc/php/${php_version}/mods-available/xdebug.ini"
  if [[ -f $xdebug_ini ]]; then
    if ! grep -q "xdebug.mode" "$xdebug_ini"; then
      echo "xdebug.mode=debug" | sudo tee -a "$xdebug_ini" >/dev/null
    else
      sudo sed -i 's/^;*xdebug.mode.*/xdebug.mode=debug/' "$xdebug_ini"
    fi
  fi
}

install_node() {
  echo -e "Installing Node.js...\n"
  mise use --global node
}

case "$1" in
ruby)
  echo -e "Installing Ruby on Rails...\n"
  omybuntu-pkg-add libyaml-dev
  mise settings add ruby.compile false
  mise settings add idiomatic_version_file_enable_tools ruby
  mise use --global ruby@latest
  echo "gem: --no-document" >~/.gemrc
  mise x ruby -- gem install rails --no-document
  echo -e "\n✅ Success: Ruby on Rails installed. You can now run: rails new myproject"
  ;;
node)
  install_node
  echo -e "\n✅ Success: Node.js installed."
  ;;
bun)
  echo -e "Installing Bun...\n"
  mise use -g bun@latest
  echo -e "\n✅ Success: Bun installed."
  ;;
deno)
  echo -e "Installing Deno...\n"
  mise use -g deno@latest
  echo -e "\n✅ Success: Deno installed."
  ;;
go)
  echo -e "Installing Go...\n"
  mise use --global go@latest
  echo -e "\n✅ Success: Go installed."
  ;;
php)
  echo -e "Installing PHP...\n"
  install_php
  echo -e "\n✅ Success: PHP installed."
  ;;
laravel)
  echo -e "Installing PHP and Laravel...\n"
  install_php
  install_node
  composer global require laravel/installer
  echo -e "\n✅ Success: Laravel installed. You can now run: laravel new myproject"
  ;;
symfony)
  echo -e "Installing PHP and Symfony...\n"
  install_php
  curl -sS https://get.symfony.com/cli/installer | bash
  mkdir -p ~/.local/bin
  mv -f ~/.symfony5/bin/symfony ~/.local/bin/symfony 2>/dev/null || true
  echo -e "\n✅ Success: Symfony installed. You can now run: symfony new --webapp myproject"
  ;;
python)
  echo -e "Installing Python...\n"
  mise use --global python@latest
  echo -e "\nInstalling uv...\n"
  curl -fsSL https://astral.sh/uv/install.sh | sh
  echo -e "\n✅ Success: Python and uv installed."
  ;;
elixir)
  echo -e "Installing Elixir...\n"
  mise use --global erlang@latest
  mise use --global elixir@latest
  mise x elixir -- mix local.hex --force
  echo -e "\n✅ Success: Elixir installed."
  ;;
phoenix)
  echo -e "Installing Phoenix Framework...\n"
  # Ensure Erlang/Elixir first
  mise use --global erlang@latest
  mise use --global elixir@latest
  # Hex & Rebar
  mise x elixir -- mix local.hex --force
  mise x elixir -- mix local.rebar --force
  # Phoenix project (phx_new)
  mise x elixir -- mix archive.install hex phx_new --force
  echo -e "\n✅ Success: Phoenix installed. You can now run: mix phx.new my_app"
  ;;
rust)
  echo -e "Installing Rust...\n"
  bash -c "$(curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs)" -- -y
  echo -e "\n✅ Success: Rust installed."
  ;;
java)
  echo -e "Installing Java...\n"
  mise use --global java@latest
  echo -e "\n✅ Success: Java installed."
  ;;
zig)
  echo -e "Installing Zig...\n"
  mise use --global zig@latest
  mise use -g zls@latest
  echo -e "\n✅ Success: Zig installed."
  ;;
ocaml)
  echo -e "Installing OCaml...\n"
  bash -c "$(curl -fsSL https://raw.githubusercontent.com/ocaml/opam/master/shell/install.sh)"
  opam init --yes
  eval "$(opam env)"
  opam install ocaml-lsp-server odoc ocamlformat utop --yes
  echo -e "\n✅ Success: OCaml installed."
  ;;
dotnet)
  echo -e "Installing .NET...\n"
  mise use --global dotnet@latest
  echo -e "\n✅ Success: .NET installed."
  ;;
clojure)
  echo -e "Installing Clojure...\n"
  omybuntu-pkg-add rlwrap
  mise use --global clojure@latest
  echo -e "\n✅ Success: Clojure installed."
  ;;
scala)
  echo -e "Installing Scala...\n"
  mise use --global java@latest
  mise use --global scala@latest
  mise use --global scala-cli@latest
  echo -e "\n✅ Success: Scala installed."
  ;;
esac
