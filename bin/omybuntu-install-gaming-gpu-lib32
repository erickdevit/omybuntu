#!/bin/bash

# omybuntu:summary=Install lib32 graphics drivers (Vulkan + NVIDIA) for any detected GPUs.
# omybuntu:requires-sudo=true

set -euo pipefail
trap 'echo -e "\n❌ Error: Installation failed at line $LINENO." >&2' ERR

echo "Installing lib32 graphics drivers..."

# Ensure i386 architecture is enabled for multiarch packages
sudo dpkg --add-architecture i386
sudo apt-get update

PACKAGES=()

# Intel/AMD Vulkan 32-bit drivers
if lspci | grep -iE "(VGA|Display).*(Intel|AMD)" >/dev/null; then
  PACKAGES+=("mesa-vulkan-drivers:i386")
fi

# NVIDIA 32-bit driver libraries
if omybuntu-hw-nvidia-gsp || omybuntu-hw-nvidia-without-gsp || lspci | grep -iq "NVIDIA" || omybuntu-cmd-present nvidia-smi; then
  nvidia_ver=$(dpkg -l | grep -E '^ii\s+nvidia-driver-[0-9]+' | head -n1 | awk '{print $2}' | grep -oE '[0-9]+$')
  if [[ -n $nvidia_ver ]]; then
    PACKAGES+=("libnvidia-gl-${nvidia_ver}:i386")
  else
    PACKAGES+=("libgl1-mesa-dri:i386")
  fi
fi

[[ ${#PACKAGES[@]} -gt 0 ]] && omybuntu-pkg-add "${PACKAGES[@]}"

echo "✅ Success: lib32 graphics drivers installed."
