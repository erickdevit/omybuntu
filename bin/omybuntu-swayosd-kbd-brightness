#!/bin/bash

# omybuntu:summary=Display keyboard brightness level using SwayOSD on the current monitor.
# omybuntu:args=<0-100>
# omybuntu:examples=omybuntu swayosd kbd brightness 0 | omybuntu swayosd kbd brightness 50 | omybuntu swayosd kbd brightness 100

percent="$1"

progress="$(awk -v p="$percent" 'BEGIN{printf "%.2f", p/100}')"
[[ $progress == "0.00" ]] && progress="0.01"

omybuntu-swayosd-client \
  --custom-icon keyboard-brightness-symbolic \
  --custom-progress "$progress" \
  --custom-progress-text "${percent}%"
