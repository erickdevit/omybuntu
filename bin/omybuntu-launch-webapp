#!/bin/bash

# omybuntu:summary=Launch a URL as a web app in the default supported browser
# omybuntu:args=<url>

browser=$(xdg-settings get default-web-browser)

case $browser in
  *chrom* | *Chrom* | *brave* | *edge* | *opera* | *vivaldi* | *helium*)
    ;;
  *)
    # Fallback for Firefox or others that don't support --app
    # Try to find a chromium-based browser available on the system
    if ls /var/lib/snapd/desktop/applications/chromium_*.desktop >/dev/null 2>&1; then
      browser=$(ls -1 /var/lib/snapd/desktop/applications/chromium_*.desktop | head -1 | xargs basename)
    else
      browser="chromium.desktop"
    fi
    ;;
esac

exec_path=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' \
  ~/.local/share/applications/"$browser" \
  ~/.local/share/flatpak/exports/share/applications/"$browser" \
  ~/.nix-profile/share/applications/"$browser" \
  /usr/share/applications/"$browser" \
  /usr/local/share/applications/"$browser" \
  /var/lib/flatpak/exports/share/applications/"$browser" \
  /var/lib/snapd/desktop/applications/"$browser" 2>/dev/null | head -1)

exec setsid uwsm-app -- "$exec_path" --app="$1" "${@:2}"
