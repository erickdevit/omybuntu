#!/bin/bash
# omybuntu:summary=Set the behavior of the Caps Lock key
# omybuntu:hidden=true

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

OPT_OMARCHY="󱊷  Compose Key (Omarchy/Omybuntu)"
OPT_NORMAL="󰌌  Caps Lock (Normal)"
list="$OPT_OMARCHY\n$OPT_NORMAL"

current_label="$OPT_NORMAL"
if grep -qE "^[[:space:]]*kb_options[[:space:]]*=.*compose:caps" ~/.config/hypr/input.conf 2>/dev/null; then
    current_label="$OPT_OMARCHY"
fi

index=2
if [[ "$current_label" == "$OPT_OMARCHY" ]]; then
    index=1
fi

selected=$(echo -e "$list" | omybuntu-launch-walker --dmenu --width 350 -p "Caps Lock…" -c "$index")

if [[ -z $selected || $selected == "CNCLD" ]]; then
    exit 0
fi

if [[ "$selected" == "$OPT_OMARCHY" ]]; then
    if grep -qE "^[[:space:]]*kb_options[[:space:]]*=" ~/.config/hypr/input.conf; then
        sed -i 's/^[[:space:]]*kb_options[[:space:]]*=.*/  kb_options = compose:caps # ,grp:alts_toggle/' ~/.config/hypr/input.conf
    else
        sed -i '/^[[:space:]]*input[[:space:]]*{/a \  kb_options = compose:caps # ,grp:alts_toggle' ~/.config/hypr/input.conf
    fi
else
    # Remove kb_options
    sed -i '/^[[:space:]]*kb_options[[:space:]]*=.*/d' ~/.config/hypr/input.conf
fi

hyprctl reload >/dev/null 2>&1
