    "Disable touchpad") echo "$I18N_KB_DISABLE_TOUCHPAD" ;;
    "Volume up precise") echo "$I18N_KB_VOLUME_UP_PRECISE" ;;
    "Volume down precise") echo "$I18N_KB_VOLUME_DOWN_PRECISE" ;;
    "Brightness up precise") echo "$I18N_KB_BRIGHTNESS_UP_PRECISE" ;;
    "Brightness down precise") echo "$I18N_KB_BRIGHTNESS_DOWN_PRECISE" ;;
    "Next track") echo "$I18N_KB_NEXT_TRACK" ;;
    "Pause") echo "$I18N_KB_PAUSE" ;;
    "Play") echo "$I18N_KB_PLAY" ;;
    "Previous track") echo "$I18N_KB_PREV_TRACK" ;;
    "Switch audio output") echo "$I18N_KB_SWITCH_AUDIO" ;;
    "Copy URL from Web App") echo "$I18N_KB_COPY_URL" ;;
    *)
      if [[ "$desc" =~ ^Switch\ to\ workspace\ ([0-9]+)$ ]]; then
        printf "$I18N_KB_SWITCH_WORKSPACE" "${BASH_REMATCH[1]}"
      elif [[ "$desc" =~ ^Move\ window\ to\ workspace\ ([0-9]+)$ ]]; then
        printf "$I18N_KB_MOVE_WORKSPACE" "${BASH_REMATCH[1]}"
      elif [[ "$desc" =~ ^Move\ window\ silently\ to\ workspace\ ([0-9]+)$ ]]; then
        printf "$I18N_KB_MOVE_WORKSPACE_SILENT" "${BASH_REMATCH[1]}"
      elif [[ "$desc" =~ ^Switch\ to\ group\ window\ ([0-9]+)$ ]]; then
        printf "$I18N_KB_SWITCH_GROUP_WIN" "${BASH_REMATCH[1]}"
      else
        echo "$desc"
      fi
      ;;
  esac
}

translate_binding_stream() {
  local line modifiers key description dispatcher rest
  while IFS=, read -r modifiers key description dispatcher rest; do
    description=$(translate_description "$description")
    printf '%s,%s,%s,%s,%s\n' "$modifiers" "$key" "$description" "$dispatcher" "$rest"
  done
}

output_binding_records() {
  build_keymap_cache
  build_lua_bind_key_cache

  {
    dynamic_bindings
    static_bindings
  } |
    sort -u |
    translate_binding_stream |
    parse_keycodes |
    parse_binding_records |
    prioritize_entries
}

output_keybindings() {
  output_binding_records | cut -f1
}

dispatch_binding() {
  local dispatcher="$1"
  local arg="$2"

  case "$dispatcher" in
    exec)
      [[ -n $arg ]] && hyprctl dispatch exec "$arg"
      ;;
    "") return 1 ;;
    *)
      if [[ -n $arg ]]; then
        hyprctl dispatch "$dispatcher" "$arg"
      else
        hyprctl dispatch "$dispatcher"
      fi
      ;;
  esac
}

if [[ $1 == "--print" || $1 == "-p" ]]; then
  output_keybindings
else
  records=$(output_binding_records)
  monitor_height=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .height')
  menu_height=$((monitor_height * 40 / 100))
  selection=$(cut -f1 <<<"$records" |
    walker --dmenu -p "$I18N_MENU_KEYBINDINGS_PROMPT" --width 900 --height "$menu_height")

  if [[ -n $selection ]]; then
    record=$(awk -F '\t' -v selection="$selection" '$1 == selection { print; exit }' <<<"$records")
    dispatcher=$(cut -f2 <<<"$record")
    arg=$(cut -f3- <<<"$record")

    dispatch_binding "$dispatcher" "$arg"
  fi
fi
