#!/bin/bash

# omybuntu:summary=Install and configure Voxtype dictation
# omybuntu:requires-sudo=true

set -euo pipefail
trap 'echo -e "\n❌ Error: Installation failed at line $LINENO." >&2' ERR

# Install voxtype and configure it for use.

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

if gum confirm "$I18N_VOXTYPE_WARN"; then
  omybuntu-pkg-add wtype voxtype-bin

  # Setup voxtype
  mkdir -p ~/.config/voxtype
  cp $OMYBUNTU_PATH/default/voxtype/config.toml ~/.config/voxtype/

  voxtype setup --download --no-post-install
  if omybuntu-hw-vulkan; then
    voxtype setup gpu --enable || true
  fi
  voxtype setup systemd

  omybuntu-hyprland-toggle voxtype on
  omybuntu-restart-waybar
  omybuntu-notification-send -g  "$I18N_VOXTYPE_READY" "$I18N_VOXTYPE_READY_MSG"
  echo "✅ Success: Voxtype installed."
fi
