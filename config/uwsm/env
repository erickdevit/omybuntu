# Changes require a restart to take effect.

# Ensure Omybuntu bins are in the path
export OMYBUNTU_PATH=$HOME/.local/share/omybuntu
export PATH=$OMYBUNTU_PATH/bin:$PATH:$HOME/.local/bin

# Set default terminal and editor
source ~/.config/uwsm/default

# Activate mise if present on the system
omybuntu-cmd-present mise && eval "$(mise activate bash --shims)"
