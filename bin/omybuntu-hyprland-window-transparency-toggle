#!/bin/bash

# omybuntu:summary=Toggles transparency for the currently focused window.

current=$(hyprctl getprop active opaque 2>/dev/null)

if [[ "$current" == "false" || "$current" == "0" ]]; then
  hyprctl dispatch setprop active opaque 1 lock >/dev/null 2>&1
else
  hyprctl dispatch setprop active opaque 0 lock >/dev/null 2>&1
fi
