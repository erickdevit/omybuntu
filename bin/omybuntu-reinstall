#!/bin/bash

# omybuntu:summary=Reinstall Omybuntu packages and reset default configs
# omybuntu:requires-sudo=true

set -e

# Attempt to reinstall all default Omybuntu packages and reset all the default configs.

echo -e "This will reinstall all the default Omybuntu packages and reset all default configs.\nWarning: All user changes to configs will be lost.\n"

if gum confirm "Are you sure you want to reinstall and lose all config changes?"; then
  omybuntu-reinstall-git
  omybuntu-reinstall-pkgs
  omybuntu-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && omybuntu-system-reboot
fi
