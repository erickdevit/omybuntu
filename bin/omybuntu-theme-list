#!/bin/bash

# omybuntu:summary=List available themes
# omybuntu:examples=omybuntu theme list | omybuntu theme set "Tokyo Night"

{
  find ~/.config/omybuntu/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$OMYBUNTU_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  echo "$name" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
done
