#!/bin/bash

# omybuntu:summary=Prompt for confirmation before starting an update

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

gum style --border normal --padding "1 2" \
  "$I18N_UPD_READY" \
  "" \
  "$I18N_UPD_WARN_NO_STOP" \
  "$I18N_UPD_WARN_POWER" \
  "" \
  "$I18N_UPD_WHATS_NEW"

echo

if ! gum confirm "$I18N_UPDATE_PROCEED"; then
  echo "$I18N_UPD_CANCELLED"
  exit 1
fi
