#!/bin/bash

# omybuntu:summary=Returns true if any of the named packages are missing from the system (or false if they're all there).
# omybuntu:args=<packages...>

for pkg in "$@"; do
  if ! (dpkg -l "$pkg" 2>/dev/null | grep -q "^ii") && ! snap list "$pkg" &>/dev/null; then
    exit 0
  fi
done

exit 1
