#!/bin/bash

# omybuntu:summary=Set the Omybuntu channel, which dictates what git branch and package repository is used.
# omybuntu:args=<stable|rc|edge|dev>

if (($# == 0)); then
  echo "Usage: omybuntu-channel-set [stable|rc|edge|dev]"
  exit 1
else
  channel="$1"
fi

if [[ $channel != "stable" && $channel != "rc" && $channel != "edge" && $channel != "dev" ]]; then
  echo "Error: Invalid channel '$channel'. Must be one of: stable, rc, edge, dev"
  exit 1
fi

case "$channel" in
"stable") omybuntu-branch-set "master" ;;
"rc") omybuntu-branch-set "rc" ;;
"edge") omybuntu-branch-set "master" ;;
"dev") omybuntu-branch-set "dev" ;;
esac

# Persist the channel name to user's state
STATE_DIR="$HOME/.local/state/omybuntu"
mkdir -p "$STATE_DIR"
echo "$channel" > "$STATE_DIR/channel"

# Refresh apt config and databases for the selected channel
if omybuntu-cmd-present omybuntu-refresh-apt; then
  omybuntu-refresh-apt "$channel"
fi

omybuntu-update -y
