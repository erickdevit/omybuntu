#!/bin/bash

# omybuntu:summary=Toggles transparency for the currently focused window.

addr=$(hyprctl activewindow -j | jq -r '.address')

if ! hyprctl dispatch "hl.dsp.window.set_prop({ window = \"address:$addr\", prop = \"opaque\", value = \"toggle\" })" >/dev/null 2>&1; then
  current=$(hyprctl getprop "address:$addr" opaque 2>/dev/null)
  if [[ "$current" == "false" || "$current" == "0" ]]; then
    hyprctl setprop "address:$addr" opaque 1 lock >/dev/null 2>&1
  else
    hyprctl setprop "address:$addr" opaque 0 lock >/dev/null 2>&1
  fi
fi
