#!/bin/bash

# omybuntu:summary=Enable, disable, toggle, or recover mirroring the internal display to an external monitor
# omybuntu:args=<on|off|toggle|recover>

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

TOGGLE="internal-monitor-mirror"
TOGGLE_FLAG="$HOME/.local/state/omybuntu/toggles/hypr/$TOGGLE.lua"
DISABLE_TOGGLE="internal-monitor-disable"

# Get names dynamically
INTERNAL=$(hyprctl monitors -j | jq -r '.[] | select(.name | contains("eDP")).name' | head -n 1)
# Get the first available external monitor
EXTERNAL=$(hyprctl monitors -j | jq -r '.[] | select(.name | contains("eDP") | not).name' | head -n 1)

on() {
  if [[ -z $EXTERNAL ]]; then
    omybuntu-notification-send -g 󰍹 "$I18N_MON_MIRROR_NO_EXTERNAL"
    exit 1
  fi

  if [[ -z $INTERNAL ]]; then
    omybuntu-notification-send -g 󰍹 "$I18N_MON_MIRROR_NO_INTERNAL"
    exit 1
  fi

  omybuntu-hyprland-toggle $DISABLE_TOGGLE off

  if omybuntu-hyprland-toggle-disabled $TOGGLE; then
    printf 'hl.monitor({ output = "%s", mode = "preferred", position = "auto", scale = 1, mirror = "%s" })\n' "$EXTERNAL" "$INTERNAL" >"$TOGGLE_FLAG"
    omybuntu-notification-send -g 󰍹 "$(printf "$I18N_MON_MIRROR_ENABLED" "$EXTERNAL")"
    hyprctl reload
  fi
}

off() {
  if omybuntu-hyprland-toggle-enabled $TOGGLE; then
    omybuntu-hyprland-toggle $TOGGLE off
    omybuntu-notification-send -g 󰍹 "$I18N_MON_MIRROR_EXTENDED_RESTORED"
  fi
}

toggle() {
  if omybuntu-hyprland-toggle-enabled $TOGGLE; then
    off
  else
    on
  fi
}

recover() {
  if ! omybuntu-hw-external-monitors && omybuntu-hyprland-toggle-enabled $TOGGLE; then
    omybuntu-hyprland-toggle $TOGGLE off
  fi
}

case "$1" in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
