#!/bin/bash

# omybuntu:summary=Set and show lightweight desktop notification reminders
# omybuntu:args=<minutes> [message] | show | clear
# omybuntu:examples=omybuntu reminder 5 | omybuntu reminder 30 "Check the oven" | omybuntu reminder show | omybuntu reminder clear

set -euo pipefail

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"


format_remaining() {
  local seconds=$1
  local minutes=$((seconds / 60))
  local remainder=$((seconds % 60))

  if ((minutes > 0 && remainder > 0)); then
    echo "${minutes}m ${remainder}s"
  elif ((minutes > 0)); then
    echo "${minutes}m"
  else
    echo "${remainder}s"
  fi
}

parse_systemd_timespan() {
  local timespan="$1"
  local total=0
  local value unit whole

  while read -r value unit; do
    whole=${value%.*}

    case $unit in
    d) total=$((total + whole * 86400)) ;;
    h) total=$((total + whole * 3600)) ;;
    min) total=$((total + whole * 60)) ;;
    s) total=$((total + whole)) ;;
    ms | us) ;;
    esac
  done < <(grep -oE '[0-9]+([.][0-9]+)?(d|h|min|s|ms|us)' <<<"$timespan" | sed -E 's/^([0-9.]+)([a-z]+)$/\1 \2/')

  echo "$total"
}

show_reminders() {
  local timer next remaining body=""
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/omybuntu-reminders"
  local reminder_message=""
  local now=$(date +%s)

  while IFS=$'\t' read -r timer next; do
    [[ -z $timer || -z $next ]] && continue

    next=$((next / 1000000))
    ((next <= now)) && continue

    remaining=$((next - now))
    reminder=${timer%.timer}
    reminder=${reminder#omybuntu-reminder-}
    set_at=${reminder##*-}
    reminder_minutes=${reminder%%m-*}
    reminder_message=""
    [[ -f $reminder_dir/${timer%.timer}.message ]] && reminder_message=$(<"$reminder_dir/${timer%.timer}.message")

    if [[ -n $reminder_message ]]; then
      body+="$reminder_message in $(format_remaining $remaining) ($(date -d "@$next" +%-H:%M))"$'\n'
    else
      body+="${reminder_minutes}-min reminder in $(format_remaining $remaining) ($(date -d "@$next" +%-H:%M))"$'\n'
    fi
  done < <(systemctl --user list-timers --all --output=json "omybuntu-reminder-*.timer" 2>/dev/null | jq -r '.[] | [.unit, .next] | @tsv')

  if [[ -z $body ]]; then
    omybuntu-notification-send -g 󰔛 "$I18N_REM_UPCOMING" "$I18N_REM_NONE"
  else
    omybuntu-notification-send -g 󰔛 "$I18N_REM_UPCOMING" "${body%$'\n'}"
  fi
}

clear_reminders() {
  local units
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/omybuntu-reminders"

  units=$(systemctl --user list-timers --all --no-legend --no-pager "omybuntu-reminder-*.timer" 2>/dev/null | awk '{ print $(NF - 1), $NF }')

  if [[ -n $units ]]; then
    xargs -r systemctl --user stop <<<"$units" || true
  fi

  rm -f "$reminder_dir"/omybuntu-reminder-*.message 2>/dev/null || true
  omybuntu-notification-send -g 󰔛 "$I18N_REM_CLEARED_ALL"
}

case ${1:-} in
show | list)
  show_reminders
  exit 0
  ;;
clear)
  clear_reminders
  exit 0
  ;;
esac

minutes=${1:-}
shift || true
message="$*"
custom_message="$message"

if [[ -z $minutes ]] || [[ ! $minutes =~ ^[0-9]+$ ]] || ((minutes == 0)); then
  echo "Usage: omybuntu-reminder <minutes> [message]"
  echo "       omybuntu-reminder show"
  echo "       omybuntu-reminder clear"
  exit 1
fi

if [[ -z $message ]]; then
  message=$(printf "$I18N_REM_TIME_UP" "$minutes")
fi

set_at=$(date +%s)
remind_at=$(date -d "+${minutes} minutes" +%H:%M)
unit="omybuntu-reminder-${minutes}m-$set_at"
reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/omybuntu-reminders"
message_file="$reminder_dir/$unit.message"
confirmation=$(printf "$I18N_REM_CONFIRM" "$remind_at")
confirmation_title=$(printf "$I18N_REM_SET_FOR" "$minutes")

mkdir -p "$reminder_dir"

if [[ -n $custom_message ]]; then
  printf "%s" "$custom_message" >"$message_file"
  confirmation_title="$custom_message (${minutes}m)"
fi

systemd-run --user --quiet --collect --on-active="${minutes}m" --unit="$unit" \
  bash -c 'omybuntu-notification-send -g 󰔛 "$1" "$2" -u critical; rm -f "$3"' bash "$I18N_REM_TITLE" "$message" "$message_file"

omybuntu-notification-send -g 󰔛 "$confirmation_title" "$confirmation"

