#!/bin/bash

# omybuntu:summary=Prompt for required reboot or service restarts after updates

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

echo

confirm_reboot() {
  gum confirm "$1" && { omybuntu-system-reboot; exit 0; }
}

running_kernel=$(uname -r)
kernel_updated=false

# On Ubuntu, check if reboot is required (kernel or system update)
if [[ -f /var/run/reboot-required ]]; then
  kernel_updated=true
fi

if [[ $kernel_updated == "true" ]]; then
  confirm_reboot "$I18N_UPD_REBOOT_KERNEL"
elif [[ -f $HOME/.local/state/omybuntu/reboot-required ]]; then
  confirm_reboot "$I18N_UPD_REBOOT_REQUIRED"
fi

running_hyprland=$(readlink /proc/$(pgrep -x Hyprland)/exe 2>/dev/null)
if [[ $running_hyprland == *"(deleted)"* ]]; then
  confirm_reboot "$I18N_UPD_REBOOT_HYPRLAND"
fi

for file in "$HOME"/.local/state/omybuntu/restart-*-required; do
  if [[ -f $file ]]; then
    filename=$(basename "$file")
    service=$(echo "$filename" | sed 's/restart-\(.*\)-required/\1/')
    echo "Restarting $service"
    omybuntu-state clear "$filename"
    omybuntu-restart-"$service"
  fi
done
