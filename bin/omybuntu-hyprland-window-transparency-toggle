#!/bin/bash

# omybuntu:summary=Toggles transparency for the currently focused window.

addr=$(hyprctl activewindow -j | jq -r '.address')
# In Hyprland 0.53+, setprop is a dispatcher. We add 'lock' to override windowrules.
hyprctl dispatch setprop "address:$addr" opaque toggle lock >/dev/null 2>&1
