#!/bin/bash

# omybuntu:summary=Add or remove an EFI boot entry for the Omybuntu UKI, allowing the system to boot directly
# omybuntu:requires-sudo=true

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

if [[ ! -d /sys/firmware/efi ]]; then
  echo "$I18N_DIRECT_BOOT_ERR_UEFI" >&2
  exit 1
fi

if ! efibootmgr &>/dev/null; then
  echo "$I18N_DIRECT_BOOT_ERR_EFIBOOTMGR" >&2
  exit 1
fi

if cat /sys/class/dmi/id/bios_vendor 2>/dev/null | grep -qi "American Megatrends"; then
  echo "$I18N_DIRECT_BOOT_ERR_AMI" >&2
  exit 1
fi

if cat /sys/class/dmi/id/bios_vendor 2>/dev/null | grep -qi "Apple"; then
  echo "$I18N_DIRECT_BOOT_ERR_APPLE" >&2
  exit 1
fi

existing_entry=$(efibootmgr | grep -E "^Boot[0-9A-Fa-f]+\*? Omybuntu([[:space:]]|$)" | head -1)

if [[ -n $existing_entry ]]; then
  boot_num=$(echo "$existing_entry" | sed -n 's/^Boot\([0-9A-Fa-f]\+\).*/\1/p')

  if gum confirm "$I18N_DIRECT_BOOT_DISABLE"; then
    removing_msg=$(printf "$I18N_DIRECT_BOOT_REMOVING" "$boot_num")
    echo "$removing_msg"
    sudo efibootmgr --bootnum "$boot_num" --delete-bootnum >/dev/null
  fi

  exit 0
else
  uki_file=$(find /boot/EFI/Linux/ -name "omybuntu*.efi" -printf "%f\n" 2>/dev/null | head -1)

  if [[ -z $uki_file ]]; then
    echo "$I18N_DIRECT_BOOT_ERR_NO_UKI" >&2
    exit 1
  fi

  boot_source=$(findmnt -n -o SOURCE /boot)
  disk=$(echo "$boot_source" | sed 's/p\?[0-9]*$//')
  part=$(echo "$boot_source" | grep -o 'p\?[0-9]*$' | sed 's/^p//')

  if gum confirm "$I18N_DIRECT_BOOT_SETUP"; then
    creating_msg=$(printf "$I18N_DIRECT_BOOT_CREATING" "$uki_file")
    echo "$creating_msg"

    sudo efibootmgr --create \
      --disk "$disk" \
      --part "$part" \
      --label "Omybuntu" \
      --loader "\\EFI\\Linux\\$uki_file"
  fi
fi
