#!/bin/bash

# omybuntu:summary=Toggle hypridle idle locking

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

flag="$HOME/.local/state/omybuntu/toggles/idle-lock-off"

ensure_hypridle_running() {
  if pgrep -x hypridle >/dev/null; then
    return 0
  fi

  if command -v uwsm-app >/dev/null 2>&1; then
    uwsm-app -- hypridle >/dev/null 2>&1 &
  else
    hypridle >/dev/null 2>&1 &
  fi
}

if [[ -f $flag ]] || ! pgrep -x hypridle >/dev/null; then
  rm -f "$flag"
  ensure_hypridle_running
  omybuntu-notification-send -g 󱫖 "$I18N_TOG_IDLE_START"
else
  mkdir -p "$(dirname "$flag")"
  touch "$flag"
  ensure_hypridle_running
  omybuntu-notification-send -g 󱫖 "$I18N_TOG_IDLE_STOP"
fi

pkill -RTMIN+9 waybar
