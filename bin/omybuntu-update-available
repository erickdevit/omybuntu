#!/bin/bash

# omybuntu:summary=Check if a new Omybuntu version is available for the active channel

channel=$(omybuntu-version-channel)

case "$channel" in
stable|edge)
  pattern_grep='^v[0-9]+'
  exclude_grep='\-(rc|dev)'
  ;;
rc)
  pattern_grep='^v[0-9]+.*\-rc'
  exclude_grep='^$'
  ;;
dev)
  pattern_grep='^v[0-9]+.*\-dev'
  exclude_grep='^$'
  ;;
*)
  pattern_grep='^v[0-9]+'
  exclude_grep='\-(rc|dev)'
  ;;
esac

# Fetch latest remote tag matching the channel
latest_tag=$(git -C "$OMYBUNTU_PATH" ls-remote --tags origin | grep -v "{}" | awk '{print $2}' | sed 's#refs/tags/##' | grep -E "$pattern_grep" | grep -vE "$exclude_grep" | sort -V | tail -n 1)

if [[ -z $latest_tag ]]; then
  echo "Omybuntu is up to date (no remote tags for channel '$channel')"
  exit 1
fi

# Get latest local tag matching the channel
current_tag=$(git -C "$OMYBUNTU_PATH" tag --list | grep -E "$pattern_grep" | grep -vE "$exclude_grep" | sort -V | tail -n 1)

if [[ -z $current_tag ]]; then
  current_tag="none"
fi

if [[ $current_tag != $latest_tag ]]; then
  echo "Omybuntu update available ($latest_tag)"
  exit 0
else
  echo "Omybuntu is up to date ($current_tag)"
  exit 1
fi
