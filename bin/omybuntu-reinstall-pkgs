#!/bin/bash

# omybuntu:summary=Reinstall all default Omybuntu packages from the stable channel
# omybuntu:requires-sudo=true

set -e

# Reinstall all default Omybuntu packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
omybuntu-refresh-pacman

# Downgrade any packages to the stable setup
sudo pacman -Suu --noconfirm

# Ensure all packages are installed
mapfile -t packages < <(grep -v '^#' "$OMYBUNTU_PATH/install/omybuntu-base.packages" | grep -v '^$')
sudo pacman -Syu --noconfirm --needed "${packages[@]}"
