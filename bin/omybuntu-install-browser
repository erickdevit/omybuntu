#!/bin/bash

# omybuntu:summary=Install a supported browser
# omybuntu:args=<chrome|brave|brave-origin|edge|firefox|zen>
# omybuntu:examples=omybuntu install browser firefox | omybuntu install browser brave

setup_policy_directory() {
  sudo mkdir -p "$1"
  sudo chmod a+rw "$1"
}

announce_browser_installed() {
  echo ""
  echo "$1 browser installed. Make it the default via Setup > Defaults > Browser."
}

copy_chromium_flags() {
  mkdir -p ~/.config
  cp -f "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/config/chromium-flags.conf" "$1"
}

setup_firefox_preferences() {
  local distribution_dir="$1"

  setup_policy_directory "$distribution_dir"
  sudo cp -f "$OMYBUNTU_PATH/default/firefox/policies.json" "$distribution_dir/policies.json"
}

setup_firefox_wayland() {
  mkdir -p ~/.config/environment.d
  echo "MOZ_ENABLE_WAYLAND=1" > ~/.config/environment.d/omybuntu-firefox-wayland.conf
}

case $1 in
chrome)
  echo "Installing Chrome..."
  wget -q -O /tmp/google-chrome-stable_current_amd64.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
  sudo apt-get install -y /tmp/google-chrome-stable_current_amd64.deb || exit 1
  rm -f /tmp/google-chrome-stable_current_amd64.deb

  setup_policy_directory /etc/opt/chrome/policies/managed
  copy_chromium_flags ~/.config/chrome-flags.conf
  omybuntu-theme-set-browser
  announce_browser_installed "Chrome"
  ;;
edge)
  echo "Installing Edge..."
  sudo curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | sudo gpg --dearmor -o /usr/share/keyrings/microsoft-edge.gpg
  echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-edge.gpg] https://packages.microsoft.com/repos/edge stable main" | sudo tee /etc/apt/sources.list.d/microsoft-edge.list
  sudo apt-get update
  sudo apt-get install -y microsoft-edge-stable || exit 1

  setup_policy_directory /etc/opt/edge/policies/managed
  copy_chromium_flags ~/.config/microsoft-edge-stable-flags.conf
  omybuntu-theme-set-browser
  announce_browser_installed "Edge"
  ;;
brave)
  echo "Installing Brave..."
  sudo curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg
  echo "deb [signed-by=/usr/share/keyrings/brave-browser-archive-keyring.gpg] https://brave-browser-apt-release.s3.brave.com/ stable main" | sudo tee /etc/apt/sources.list.d/brave-browser-release.list
  sudo apt-get update
  sudo apt-get install -y brave-browser || exit 1

  setup_policy_directory /etc/brave/policies/managed
  copy_chromium_flags ~/.config/brave-flags.conf
  omybuntu-theme-set-browser
  announce_browser_installed "Brave"
  ;;
brave-origin)
  echo "Installing Brave Origin..."
  sudo curl -fsSLo /usr/share/keyrings/brave-browser-beta-archive-keyring.gpg https://brave-browser-apt-beta.s3.brave.com/brave-browser-beta-archive-keyring.gpg
  echo "deb [signed-by=/usr/share/keyrings/brave-browser-beta-archive-keyring.gpg] https://brave-browser-apt-beta.s3.brave.com/ stable main" | sudo tee /etc/apt/sources.list.d/brave-browser-beta-release.list
  sudo apt-get update
  sudo apt-get install -y brave-browser-beta || exit 1

  setup_policy_directory /etc/brave/policies/managed
  mkdir -p ~/.config
  # FIXME: Use normal chromium flags when Brave Origin wrapper has been fixed
  echo "--load-extension=~/.local/share/omybuntu/default/chromium/extensions/copy-url" > ~/.config/brave-origin-beta-flags.conf
  omybuntu-theme-set-browser
  announce_browser_installed "Brave Origin"
  ;;
firefox)
  echo "Installing Firefox..."
  omybuntu-pkg-add firefox || exit 1

  setup_firefox_preferences /usr/lib/firefox/distribution
  setup_firefox_wayland
  announce_browser_installed "Firefox"
  ;;
zen)
  echo "Installing Zen..."
  wget -q -O /tmp/zen.tar.xz https://github.com/zen-browser/desktop/releases/latest/download/zen.linux-x86_64.tar.xz
  sudo mkdir -p /opt
  sudo tar -xf /tmp/zen.tar.xz -C /opt/
  if [[ -d /opt/zen ]]; then
    sudo rm -rf /opt/zen-browser
    sudo mv /opt/zen /opt/zen-browser
  fi
  sudo ln -sf /opt/zen-browser/zen /usr/local/bin/zen-browser
  sudo cp /opt/zen-browser/zen.desktop /usr/share/applications/zen.desktop
  sudo sed -i 's|Exec=zen|Exec=/opt/zen-browser/zen|g' /usr/share/applications/zen.desktop
  sudo sed -i 's|Icon=zen|Icon=/opt/zen-browser/browser/chrome/icons/default/default128.png|g' /usr/share/applications/zen.desktop
  rm -f /tmp/zen.tar.xz

  setup_firefox_preferences /opt/zen-browser/distribution
  setup_firefox_wayland
  announce_browser_installed "Zen"
  ;;
*)
  echo "Usage: omybuntu-install-browser <chrome|brave|brave-origin|edge|firefox|zen>"
  exit 1
  ;;
esac
