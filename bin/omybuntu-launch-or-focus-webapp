#!/bin/bash

# omybuntu:summary=Launch or focus on a given web app identified by the window-pattern.
# omybuntu:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: omybuntu-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="omybuntu-launch-webapp $@"

exec omybuntu-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
