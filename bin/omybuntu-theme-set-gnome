#!/bin/bash

# omybuntu:summary=Apply the current theme to GNOME color mode and icon settings
# omybuntu:hidden=true

if [[ -f ~/.config/omybuntu/current/theme/light.mode ]]; then
  COLOR_SCHEME="prefer-light"
  GTK_THEME="Adwaita"
  GTK_PREFER_DARK=0
  CURSOR_THEME="volantes_cursors"
else
  COLOR_SCHEME="prefer-dark"
  GTK_THEME="Adwaita-dark"
  GTK_PREFER_DARK=1
  CURSOR_THEME="volantes_light_cursors"
fi

# Change gnome icon theme color
GNOME_ICONS_THEME=~/.config/omybuntu/current/theme/icons.theme
if [[ -f $GNOME_ICONS_THEME ]]; then
  ICON_THEME="$(<$GNOME_ICONS_THEME)"
else
  ICON_THEME="Yaru-blue"
fi

gsettings set org.gnome.desktop.interface color-scheme "$COLOR_SCHEME" >/dev/null 2>&1 || true
gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME" >/dev/null 2>&1 || true
gsettings set org.gnome.desktop.interface icon-theme "$ICON_THEME" >/dev/null 2>&1 || true
gsettings set org.gnome.desktop.interface cursor-theme "$CURSOR_THEME" >/dev/null 2>&1 || true

# Set GTK settings files too. This is required for live/chroot profiles where
# GSettings may not have a user dconf database yet.
for gtk_version in "gtk-3.0" "gtk-4.0"; do
  mkdir -p ~/.config/"$gtk_version"
  settings_file=~/.config/"$gtk_version"/settings.ini
  cat > "$settings_file" <<EOF
[Settings]
gtk-theme-name=$GTK_THEME
gtk-icon-theme-name=$ICON_THEME
gtk-cursor-theme-name=$CURSOR_THEME
gtk-application-prefer-dark-theme=$GTK_PREFER_DARK
EOF
done

# Set cursor theme in X11 fallback
mkdir -p ~/.icons/default
cat > ~/.icons/default/index.theme <<EOF
[Icon Theme]
Inherits=$CURSOR_THEME
EOF

# Set cursor theme in Hyprland on the fly
hyprctl setcursor "$CURSOR_THEME" 24 >/dev/null 2>&1 || true
