#!/bin/bash

# omybuntu:summary=Refresh the SDDM theme from default
# omybuntu:requires-sudo=true

OMYBUNTU_PATH="${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}"

theme_dir="/usr/share/sddm/themes/omybuntu"
staging_dir=$(mktemp -d)
trap 'rm -rf "$staging_dir"' EXIT

cp -a "$OMYBUNTU_PATH/default/sddm/omybuntu/." "$staging_dir/"
omybuntu-cmd-generate-ascii-logo "$staging_dir/logo.png"

sudo rm -rf "$theme_dir"
sudo cp -a "$staging_dir/." "$theme_dir/"
