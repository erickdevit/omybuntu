#!/bin/bash

# omybuntu:summary=Toggle passwordless sudo for the current user.
# omybuntu:args=[MINUTES]
# omybuntu:requires-sudo=true

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

NOPASSWD_FILE="/etc/sudoers.d/99-omybuntu-nopasswd-${USER}"
TIMER_NAME="omybuntu-nopasswd-expire-${USER}"

MINUTES=${1:-15}
if [[ $1 && ! $1 =~ ^[0-9]+$ ]]; then
  echo "Usage: omybuntu-sudo-passwordless [MINUTES]" >&2
  exit 1
fi

echo "$I18N_SUDO_TOGGLE"

# Safety: if the file exists but the timer doesn't (e.g. after reboot), clean up
if sudo test -f "$NOPASSWD_FILE" && ! systemctl is-active "${TIMER_NAME}.timer" &>/dev/null; then
  sudo rm "$NOPASSWD_FILE"
fi

# Check for the file directly — sudo -n can stay cached or be granted by other rules
if sudo test -f "$NOPASSWD_FILE"; then
  if [[ $1 ]]; then
    sudo systemctl stop "${TIMER_NAME}.timer" 2>/dev/null
    sudo systemd-run --on-active=${MINUTES}m --timer-property=AccuracySec=1s --unit="$TIMER_NAME" \
      rm "$NOPASSWD_FILE"
    msg=$(printf "$I18N_SUDO_TIMER_UPDATED" "$MINUTES")
    echo "$msg"
  else
    sudo rm "$NOPASSWD_FILE"
    sudo systemctl stop "${TIMER_NAME}.timer" 2>/dev/null
    echo "$I18N_SUDO_DISABLED"
  fi
else
  echo ""
  echo "$I18N_SUDO_WARN_1"
  msg2=$(printf "$I18N_SUDO_WARN_2" "$MINUTES")
  echo "$msg2"
  echo ""
  echo "$I18N_SUDO_WARN_3"
  echo "$I18N_SUDO_WARN_4"
  echo "$I18N_SUDO_WARN_5"
  echo ""
  msg6=$(printf "$I18N_SUDO_WARN_6" "$MINUTES")
  echo "$msg6"
  echo "$I18N_SUDO_WARN_7"
  echo ""

  local risk_prompt
  risk_prompt=$(printf "$I18N_SUDO_RISK" "$MINUTES")
  if gum confirm "$risk_prompt"; then
    echo "${USER} ALL=(ALL) NOPASSWD: ALL" | sudo tee "$NOPASSWD_FILE" > /dev/null
    sudo chmod 440 "$NOPASSWD_FILE"
    sudo systemd-run --on-active=${MINUTES}m --timer-property=AccuracySec=1s --unit="$TIMER_NAME" \
      rm "$NOPASSWD_FILE"

    echo ""
    enabled_msg=$(printf "$I18N_SUDO_ENABLED" "$MINUTES")
    echo "$enabled_msg"
    echo "$I18N_SUDO_RESTART_NOTE"
  else
    echo "$I18N_SUDO_ABORTED"
  fi
fi
