#!/bin/bash

# omybuntu:summary=Set Hyprland, Hyprlock, Mako, and Walker corners to sharp or round
# omybuntu:args=<sharp|round>
# omybuntu:examples=omybuntu style corners round | omybuntu style corners sharp

if [[ $1 != "sharp" && $1 != "round" ]]; then
  echo "Usage: omybuntu-style-corners <sharp|round>"
  exit 1
fi

omybuntu-style-corners-hyprland "$1"
omybuntu-style-corners-hyprlock "$1"
omybuntu-style-corners-mako "$1"
omybuntu-style-corners-walker "$1"

case $1 in
  sharp) omybuntu-notification-send "Sharp corners enabled" -g 󰝣 ;;
  round) omybuntu-notification-send "Round corners enabled" -g 󰘇 ;;
esac
