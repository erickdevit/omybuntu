#!/bin/bash

# omybuntu:summary=Edit, set, or reset screensaver branding
# omybuntu:group=branding
# omybuntu:name=screensaver
# omybuntu:args=<image|text|reset>
# omybuntu:examples=omybuntu branding screensaver image | omybuntu branding screensaver text | omybuntu branding screensaver reset

set -euo pipefail

SOURCE_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}"

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

case "${1:-}" in
image)
  local picker_msg
  picker_msg=$(printf "$I18N_BRANDING_PICK_IMAGE" "$SOURCE_DIR")
  image=$(omybuntu-menu-file "$picker_msg" "${SOURCE_DIR}" "svg png")
  if [[ -n $image ]] && omybuntu-transcode-ascii "$image" ~/.config/omybuntu/branding/screensaver.txt; then
    omybuntu-launch-screensaver force >/dev/null 2>&1
  fi
  ;;
text)
  omybuntu-launch-editor ~/.config/omybuntu/branding/screensaver.txt >/dev/null 2>&1 && omybuntu-launch-screensaver force >/dev/null 2>&1
  ;;
reset)
  cp "$OMYBUNTU_PATH/logo.txt" ~/.config/omybuntu/branding/screensaver.txt && omybuntu-launch-screensaver force >/dev/null 2>&1
  ;;
*)
  echo "Usage: omybuntu-branding-screensaver <image|text|reset>" >&2
  exit 1
  ;;
esac
