#!/bin/bash

# omybuntu:summary=Set the Omybuntu channel, which dictates what git branch and package repository is used.
# omybuntu:args=<stable|rc|edge|dev>
# omybuntu:requires-sudo=true

if (($# == 0)); then
  echo "Usage: omybuntu-channel-set [stable|rc|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") omybuntu-branch-set "master" && omybuntu-refresh-pacman "stable" ;;
"rc") omybuntu-branch-set "rc" && omybuntu-refresh-pacman "rc" ;;
"edge") omybuntu-branch-set "master" && omybuntu-refresh-pacman "edge" ;;
"dev") omybuntu-branch-set "dev" && omybuntu-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

omybuntu-update -y
