}

show_update_password_menu() {
  case $(menu "$I18N_UPD_PASSWORD_PROMPT" "$I18N_PWD_DRIVE\n$I18N_PWD_USER") in
  *"$I18N_PWD_DRIVE"*) present_terminal omybuntu-drive-password ;;
  *"$I18N_PWD_USER"*) present_terminal passwd ;;
  *) show_update_menu ;;
  esac
}

show_about() {
  omybuntu-launch-about
}

show_system_menu() {
  local options="$I18N_SYS_SCREENSAVER\n$I18N_SYS_LOCK"
  ! omybuntu-toggle-enabled suspend-off && options="$options\n$I18N_SYS_SUSPEND"
  omybuntu-hibernation-available && options="$options\n$I18N_SYS_HIBERNATE"
  options="$options\n$I18N_SYS_LOGOUT\n$I18N_SYS_RESTART\n$I18N_SYS_SHUTDOWN"

  case $(menu "$I18N_MENU_SYSTEM" "$options") in
  *"$I18N_SYS_SCREENSAVER"*) omybuntu-launch-screensaver force ;;
  *"$I18N_SYS_LOCK"*) omybuntu-system-lock ;;
  *"$I18N_SYS_SUSPEND"*) systemctl suspend ;;
  *"$I18N_SYS_HIBERNATE"*) systemctl hibernate ;;
  *"$I18N_SYS_LOGOUT"*) omybuntu-system-logout ;;
  *"$I18N_SYS_RESTART"*) omybuntu-system-reboot ;;
  *"$I18N_SYS_SHUTDOWN"*) omybuntu-system-shutdown ;;
  *) back_to show_main_menu ;;
  esac
}

show_language_menu() {
  case $(menu "$I18N_SET_LANGUAGE" "English\nPortuguês (Brasil)\nEspañol") in
  *English*) echo "en" > ~/.config/omybuntu/language ;;
  *Português*) echo "pt-br" > ~/.config/omybuntu/language ;;
  *Español*) echo "es" > ~/.config/omybuntu/language ;;
  esac

  # Reload translation variables
  source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

  # Update hyprlock placeholder text immediately
  if [[ -f ~/.config/hypr/hyprlock.conf ]]; then
    local placeholder
    if grep -q "fingerprint:enabled = true" ~/.config/hypr/hyprlock.conf 2>/dev/null; then
      placeholder="<span> $I18N_HYPRLOCK_PLACEHOLDER 󰈷 </span>"
    else
      placeholder="$I18N_HYPRLOCK_PLACEHOLDER"
    fi
    sed -i "s/placeholder_text = .*/placeholder_text = ${placeholder//\//\\/}/" ~/.config/hypr/hyprlock.conf
  fi

  # Back to setup menu
  show_setup_menu
}

show_main_menu() {
  go_to_menu "$(menu "$I18N_MENU_GO" "$I18N_OPT_APPS\n$I18N_OPT_LEARN\n$I18N_OPT_TRIGGER\n$I18N_OPT_STYLE\n$I18N_OPT_SETUP\n$I18N_OPT_INSTALL\n$I18N_OPT_REMOVE\n$I18N_OPT_UPDATE\n$I18N_OPT_ABOUT\n$I18N_OPT_SYSTEM")"
}

go_to_menu() {
  local val="$1"
  case "$val" in
  *"$I18N_OPT_APPS"* | *apps*) walker -p "$I18N_MENU_LAUNCH_PROMPT" ;;
  *"$I18N_OPT_LEARN"* | *learn*) show_learn_menu ;;
  *"$I18N_OPT_TRIGGER"* | *trigger*) show_trigger_menu ;;
  *"$I18N_OPT_STYLE"* | *style*) show_style_menu ;;
  *"$I18N_OPT_SETUP"* | *setup*) show_setup_menu ;;
  *"$I18N_OPT_INSTALL"* | *install*) show_install_menu ;;
  *"$I18N_OPT_REMOVE"* | *remove*) show_remove_menu ;;
  *"$I18N_OPT_UPDATE"* | *update*) show_update_menu ;;
  *"$I18N_OPT_ABOUT"* | *about*) show_about ;;
  *"$I18N_OPT_SYSTEM"* | *system*) show_system_menu ;;
  # English-only legacy or CLI argument entry points
  *toggle*) show_toggle_menu ;;
  *hardware*) show_hardware_menu ;;
  *share*) show_share_menu ;;
  *reminder-set*) show_custom_reminder_input ;;
  *reminder*) show_reminder_menu ;;
  *background*) show_background_menu ;;
  *capture*) show_capture_menu ;;
  *theme*) show_theme_menu ;;
  *screenrecord*) show_screenrecord_menu ;;
  *power*) show_setup_power_menu ;;
  esac
}

# Allow user extensions and overrides
USER_EXTENSIONS="$HOME/.config/omybuntu/extensions/menu.sh"
[[ -f $USER_EXTENSIONS ]] && source "$USER_EXTENSIONS"

toggle_existing_menu

if [[ -n $1 ]]; then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  show_main_menu
fi
