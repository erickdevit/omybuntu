#!/bin/bash

# omybuntu:summary=Restore the default Omybuntu Plymouth boot theme and SDDM login screen
# omybuntu:requires-sudo=true

theme_dir="/usr/share/plymouth/themes/omybuntu"

sudo find ~/.local/share/omybuntu/default/plymouth -maxdepth 1 -type f -exec cp -t "$theme_dir/" {} +
sudo plymouth-set-default-theme omybuntu

if command -v update-initramfs &>/dev/null; then
  sudo update-initramfs -u
fi

omybuntu-refresh-sddm
