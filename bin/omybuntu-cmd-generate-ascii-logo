#!/bin/bash

# omybuntu:summary=Render logo.txt ASCII art into a PNG for Plymouth and SDDM
# omybuntu:group=cmd
# omybuntu:args=<output-path> [text-hex]
# omybuntu:hidden=true

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "Usage: omybuntu-cmd-generate-ascii-logo <output-path> [text-hex]" >&2
  exit 1
fi

OMYBUNTU_PATH="${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}"
output_path="$1"
text_hex="${2:-f59e0b}"
text_hex="${text_hex#\#}"

logo_txt="$OMYBUNTU_PATH/logo.txt"
if [[ ! -f $logo_txt ]]; then
  echo "ASCII logo source not found: $logo_txt" >&2
  exit 1
fi

if ! command -v magick >/dev/null 2>&1; then
  echo "ImageMagick (magick) is required to render the ASCII logo" >&2
  exit 1
fi

if ! [[ $text_hex =~ ^[0-9a-fA-F]{6}$ ]]; then
  echo "Invalid text color: $2 (expected #RRGGBB)" >&2
  exit 1
fi

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

resolve_font_file() {
  local candidate font_file

  if command -v fc-match >/dev/null 2>&1; then
    for candidate in \
      "JetBrainsMono Nerd Font:style=Regular" \
      "JetBrains Mono:style=Regular" \
      "Noto Sans Mono:style=Regular" \
      "DejaVu Sans Mono:style=Book" \
      "monospace:style=Regular"; do
      font_file=$(fc-match -f '%{file}\n' "$candidate" 2>/dev/null | head -n 1)
      if [[ -n $font_file && -f $font_file ]]; then
        echo "$font_file"
        return 0
      fi
    done
  fi

  for candidate in \
    /usr/local/share/fonts/truetype/omybuntu/JetBrainsMonoNerdFont-Regular.ttf \
    /usr/share/fonts/truetype/noto/NotoSansMono-Regular.ttf \
    /usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf \
    /usr/share/fonts/truetype/liberation/LiberationMono-Regular.ttf \
    /usr/share/fonts/opentype/urw-base35/NimbusMonoPS-Regular.otf; do
    if [[ -f $candidate ]]; then
      echo "$candidate"
      return 0
    fi
  done

  return 1
}

probe_line=""
while IFS= read -r line || [[ -n $line ]]; do
  if [[ -n ${line//[[:space:]]} ]]; then
    probe_line=$line
    break
  fi
done <"$logo_txt"

font=$(resolve_font_file || true)
if [[ -z $font ]]; then
  echo "No monospace font available to render the ASCII logo" >&2
  exit 1
fi

probe="$tmpdir/font-probe.png"
magick -background none -fill "#$text_hex" -font "$font" -pointsize 5 \
  label:"$probe_line" "$probe"
probe_width=$(magick identify -format '%w' "$probe" 2>/dev/null || echo 0)
if (( probe_width <= 100 )); then
  echo "Selected monospace font produced an unexpectedly small logo: $font" >&2
  exit 1
fi

line_files=()
line_index=0
while IFS= read -r line || [[ -n $line ]]; do
  [[ -z ${line//[[:space:]]} ]] && continue
  line_file="$tmpdir/line_$line_index.png"
  magick -background none -fill "#$text_hex" -font "$font" -pointsize 5 \
    label:"$line" "$line_file"
  line_files+=("$line_file")
  ((line_index++))
done <"$logo_txt"

if ((${#line_files[@]} == 0)); then
  echo "ASCII logo source is empty: $logo_txt" >&2
  exit 1
fi

mkdir -p "$(dirname "$output_path")"
magick "${line_files[@]}" -append "$output_path"
