#!/bin/bash

# omybuntu:summary=Create a desktop launcher for a terminal UI app
# omybuntu:args=[name command window-style icon-url]

set -e

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

if (( $# != 4 )); then
  echo -e "\e[32m$I18N_TUI_CREATE_INTRO\n\e[0m"
  APP_NAME=$(gum input --prompt "$I18N_TUI_NAME_PROMPT" --placeholder "$I18N_TUI_NAME_PLACEHOLDER")
  APP_EXEC=$(gum input --prompt "$I18N_TUI_EXEC_PROMPT" --placeholder "$I18N_TUI_EXEC_PLACEHOLDER")
  WINDOW_STYLE=$(gum choose --header "$I18N_TUI_STYLE_HEADER" float tile)
  ICON_URL=$(gum input --prompt "$I18N_TUI_ICON_PROMPT" --placeholder "$I18N_TUI_ICON_PLACEHOLDER")
else
  APP_NAME="$1"
  APP_EXEC="$2"
  WINDOW_STYLE="$3"
  ICON_URL="$4"
fi

if [[ -z $APP_NAME || -z $APP_EXEC || -z $ICON_URL ]]; then
  echo "$I18N_TUI_ERR_FIELDS"
  exit 1
fi

ICON_DIR="$HOME/.local/share/applications/icons"
DESKTOP_FILE="$HOME/.local/share/applications/$APP_NAME.desktop"

if [[ ! $ICON_URL =~ ^https?:// ]] && [[ -f $ICON_URL ]]; then
  ICON_PATH="$ICON_URL"
else
  ICON_PATH="$ICON_DIR/$APP_NAME.png"
  mkdir -p "$ICON_DIR"
  if ! curl -sL -o "$ICON_PATH" "$ICON_URL"; then
    echo "$I18N_TUI_ERR_DOWNLOAD"
    exit 1
  fi
fi

if [[ $WINDOW_STYLE == "float" ]]; then
  APP_CLASS="TUI.float"
else
  APP_CLASS="TUI.tile"
fi

cat >"$DESKTOP_FILE" <<EOF
[Desktop Entry]
Version=1.0
Name=$APP_NAME
Comment=$APP_NAME
Exec=xdg-terminal-exec --app-id=$APP_CLASS -e $APP_EXEC
Terminal=false
Type=Application
Icon=$ICON_PATH
StartupNotify=true
EOF

chmod +x "$DESKTOP_FILE"

if (( $# != 4 )); then
  success_msg=$(printf "$I18N_TUI_SUCCESS_LAUNCHER" "$APP_NAME")
  echo -e "$success_msg\n"
fi
