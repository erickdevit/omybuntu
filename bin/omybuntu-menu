#!/bin/bash

# omybuntu:summary=Launch the Omybuntu Menu or takes a parameter to jump straight to a submenu.

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

# Set to true when going directly to a submenu, so we can exit directly
BACK_TO_EXIT=false

back_to() {
  local parent_menu="$1"

  if [[ $BACK_TO_EXIT == "true" ]]; then
    exit 0
  elif [[ -n $parent_menu ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}

toggle_existing_menu() {
  if pgrep -f "walker.*--dmenu" >/dev/null; then
    walker --close >/dev/null 2>&1
    exit 0
  fi
}

menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"
  local preselect="$4"

  read -r -a args <<<"$extra"

  if [[ -n $preselect ]]; then
    local index
    index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
    if [[ -n $index ]]; then
      args+=("-c" "$index")
    fi
  fi

  echo -e "$options" | omybuntu-launch-walker --dmenu --width 295 --minheight 1 --maxheight 630 -p "$prompt…" "${args[@]}" 2>/dev/null
}

terminal() {
  xdg-terminal-exec --app-id=org.omybuntu.terminal "$@"
}

present_terminal() {
  omybuntu-launch-floating-terminal-with-presentation $1
}

open_in_editor() {
  omybuntu-notification-send -u low "$I18N_MENU_EDITING_CONFIG" "$1"
  omybuntu-launch-editor "$1"
}

hypr_config_file() {
  local name="$1"
  printf '%s/.config/hypr/%s.conf' "$HOME" "$name"
}

install() {
  present_terminal "echo 'Installing $1...'; omybuntu-pkg-add $2"
}

install_and_launch() {
  present_terminal "echo 'Installing $1...'; omybuntu-pkg-add $2 && setsid gtk-launch $3"
}

install_font() {
  local font_pkg="$2"
  local font_family="$3"
  local zip_name=""
  case "$font_pkg" in
    ttf-cascadia-mono-nerd) zip_name="CascadiaMono.tar.xz" ;;
    ttf-meslo-nerd) zip_name="Meslo.tar.xz" ;;
    ttf-firacode-nerd) zip_name="FiraCode.tar.xz" ;;
    ttf-victor-mono-nerd) zip_name="VictorMono.tar.xz" ;;
    ttf-bitstream-vera-mono-nerd) zip_name="BitstreamVeraSansMono.tar.xz" ;;
    ttf-iosevka-nerd) zip_name="Iosevka.tar.xz" ;;
  esac

  if [[ -n $zip_name ]]; then
    present_terminal "echo 'Installing $1...'; mkdir -p ~/.local/share/fonts && curl -fsSL -o /tmp/$zip_name 'https://github.com/ryanoasis/nerd-fonts/releases/latest/download/$zip_name' && tar -xf /tmp/$zip_name -C ~/.local/share/fonts/ && rm -f /tmp/$zip_name && fc-cache -f && sleep 1 && omybuntu-font-set '$font_family'"
  else
    present_terminal "echo 'Font package name not supported'; sleep 2"
  fi
}

install_terminal() {
  present_terminal "omybuntu-install-terminal $1"
}

pkg_install() {
  present_terminal "echo 'Installing $1...'; omybuntu-pkg-add $2"
}

pkg_install_and_launch() {
  present_terminal "echo 'Installing $1...'; omybuntu-pkg-add $2 && setsid gtk-launch $3"
}

show_learn_menu() {
  case $(menu "$I18N_MENU_LEARN" "$I18N_LEARN_KEYBINDINGS\n$I18N_LEARN_TMUX\n$I18N_LEARN_OMYBUNTU\n$I18N_LEARN_HYPRLAND\n$I18N_LEARN_UBUNTU\n$I18N_LEARN_NEOVIM\n$I18N_LEARN_BASH") in
  *"$I18N_LEARN_TMUX"*) omybuntu-menu-tmux-keybindings ;;
  *"$I18N_LEARN_KEYBINDINGS"*) omybuntu-menu-keybindings ;;
  *"$I18N_LEARN_OMYBUNTU"*) omybuntu-launch-webapp "https://learn.omacom.io/2/the-omybuntu-manual" ;;
  *"$I18N_LEARN_HYPRLAND"*) omybuntu-launch-webapp "https://wiki.hypr.land/" ;;
  *"$I18N_LEARN_UBUNTU"*) omybuntu-launch-webapp "https://help.ubuntu.com/" ;;
  *"$I18N_LEARN_BASH"*) omybuntu-launch-webapp "https://devhints.io/bash" ;;
  *"$I18N_LEARN_NEOVIM"*) omybuntu-launch-webapp "https://www.lazyvim.org/keymaps" ;;
  *) show_main_menu ;;
  esac
}

show_trigger_menu() {
  case $(menu "$I18N_MENU_TRIGGER" "$I18N_TRIG_REMINDER\n$I18N_TRIG_CAPTURE\n$I18N_TRIG_TRANSCODE\n$I18N_TRIG_SHARE\n$I18N_TRIG_TOGGLE\n$I18N_TRIG_MONITORS_TUI\n$I18N_TRIG_PROJECT\n$I18N_TRIG_HARDWARE") in
  *"$I18N_TRIG_REMINDER"*) show_reminder_menu ;;
  *"$I18N_TRIG_CAPTURE"*) show_capture_menu ;;
  *"$I18N_TRIG_TRANSCODE"*) omybuntu-transcode || back_to show_trigger_menu ;;
  *"$I18N_TRIG_SHARE"*) show_share_menu ;;
  *"$I18N_TRIG_TOGGLE"*) show_toggle_menu ;;
  *"$I18N_TRIG_MONITORS_TUI"*) omybuntu-launch-tui omybuntu-tui-monitors ;;
  *"$I18N_TRIG_PROJECT"*) show_project_menu ;;
  *"$I18N_TRIG_HARDWARE"*) show_hardware_menu ;;
  *) show_main_menu ;;
  esac
}

show_project_menu() {
  case $(menu "$I18N_MENU_PROJECT" "$I18N_PROJECT_MIRROR\n$I18N_PROJECT_EXTEND\n$I18N_PROJECT_SCREEN1\n$I18N_PROJECT_SCREEN2") in
  *"$I18N_PROJECT_MIRROR"*) omybuntu-hyprland-monitor-helper project mirror || back_to show_project_menu ;;
  *"$I18N_PROJECT_EXTEND"*) omybuntu-hyprland-monitor-helper project extend || back_to show_project_menu ;;
  *"$I18N_PROJECT_SCREEN1"*) omybuntu-hyprland-monitor-helper project screen1 || back_to show_project_menu ;;
  *"$I18N_PROJECT_SCREEN2"*) omybuntu-hyprland-monitor-helper project screen2 || back_to show_project_menu ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_reminder_menu() {
  case $(menu "$I18N_MENU_REMINDER" "$I18N_REM_SET\n$I18N_REM_SHOW\n$I18N_REM_CLEAR") in
  *"$I18N_REM_SET"*) show_custom_reminder_input ;;
  *"$I18N_REM_SHOW"*) omybuntu-reminder show ;;
  *"$I18N_REM_CLEAR"*) omybuntu-reminder clear ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_custom_reminder_input() {
  local minutes
  minutes=$(omybuntu-menu-input "$I18N_REM_MINUTES")

  if [[ $minutes =~ ^[0-9]+$ ]] && ((minutes > 0)); then
    show_reminder_message_input "$minutes"
  elif [[ -n $minutes ]]; then
    omybuntu-notification-send -g 󰔛 "$I18N_REM_INVALID" "$I18N_REM_INVALID_MSG" -u critical
    show_custom_reminder_input
  else
    back_to show_reminder_menu
  fi
}

show_reminder_message_input() {
  local minutes="$1"
  local message
  message=$(omybuntu-menu-input "$I18N_REM_MESSAGE")

  if [[ -n $message ]]; then
    omybuntu-reminder "$minutes" "$message"
  else
    omybuntu-reminder "$minutes"
  fi
}

show_capture_menu() {
  case $(menu "$I18N_MENU_CAPTURE" "$I18N_CAP_SCREENSHOT\n$I18N_CAP_SCREENRECORD\n$I18N_CAP_TEXT\n$I18N_CAP_COLOR") in
  *"$I18N_CAP_SCREENSHOT"*) omybuntu-capture-screenshot ;;
  *"$I18N_CAP_SCREENRECORD"*) show_screenrecord_menu ;;
  *"$I18N_CAP_TEXT"*) omybuntu-capture-text-extraction ;;
  *"$I18N_CAP_COLOR"*) pkill hyprpicker || hyprpicker -a ;;
  *) back_to show_trigger_menu ;;
  esac
}

get_webcam_list() {
  v4l2-ctl --list-devices 2>/dev/null | while IFS= read -r line; do
    if [[ $line != $'\t'* && -n $line ]]; then
      local name="$line"
      IFS= read -r device || break
      device=$(echo "$device" | tr -d '\t' | head -1)
      [[ -n $device ]] && echo "$device  $name"
    fi
  done
}

show_webcam_select_menu() {
  local devices=$(get_webcam_list)
  local count=$(echo "$devices" | grep -c . 2>/dev/null || echo 0)

  if [[ -z $devices ]] || ((count == 0)); then
    notify-send "$I18N_REC_WEBCAM_NONE" -u critical -t 3000
    return 1
  fi

  if ((count == 1)); then
    echo "$devices" | awk '{print $1}'
  else
    menu "$I18N_REC_WEBCAM_SELECT" "$devices" | awk '{print $1}'
  fi
}

show_screenrecord_menu() {
  omybuntu-capture-screenrecording --stop-recording && exit 0

  case $(menu "$I18N_MENU_SCREENRECORD" "$I18N_REC_NO_AUDIO\n$I18N_REC_DESKTOP_AUDIO\n$I18N_REC_MIC_AUDIO\n$I18N_REC_WEBCAM_AUDIO") in
  *"$I18N_REC_NO_AUDIO"*) omybuntu-capture-screenrecording ;;
  *"$I18N_REC_DESKTOP_AUDIO"*) omybuntu-capture-screenrecording --with-desktop-audio ;;
  *"$I18N_REC_MIC_AUDIO"*) omybuntu-capture-screenrecording --with-desktop-audio --with-microphone-audio ;;
  *"$I18N_REC_WEBCAM_AUDIO"*)
    local device=$(show_webcam_select_menu) || {
      back_to show_capture_menu
      return
    }
    omybuntu-capture-screenrecording --with-desktop-audio --with-microphone-audio --with-webcam --webcam-device="$device"
    ;;
  *) back_to show_capture_menu ;;
  esac
}

show_share_menu() {
  case $(menu "$I18N_MENU_SHARE" "$I18N_SHARE_CLIPBOARD\n$I18N_SHARE_FILE\n$I18N_SHARE_FOLDER\n$I18N_SHARE_RECEIVE") in
  *"$I18N_SHARE_RECEIVE"*) uwsm-app -- localsend ;;
  *"$I18N_SHARE_CLIPBOARD"*) omybuntu-menu-share clipboard ;;
  *"$I18N_SHARE_FILE"*) terminal bash -c "omybuntu-menu-share file" ;;
  *"$I18N_SHARE_FOLDER"*) terminal bash -c "omybuntu-menu-share folder" ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_toggle_menu() {
  local options="$I18N_TOG_SCREENSAVER\n$I18N_TOG_NIGHTLIGHT\n$I18N_TOG_IDLE\n$I18N_TOG_NOTIFS\n$I18N_TOG_BAR\n$I18N_TOG_LAYOUT\n$I18N_TOG_GAPS\n$I18N_TOG_RATIO\n$I18N_TOG_SCALING\n$I18N_TOG_DIRECT_BOOT\n$I18N_TOG_SUDO"

  case $(menu "$I18N_MENU_TOGGLE" "$options") in
  *"$I18N_TOG_SCREENSAVER"*) omybuntu-toggle-screensaver ;;
  *"$I18N_TOG_NIGHTLIGHT"*) omybuntu-toggle-nightlight ;;
  *"$I18N_TOG_IDLE"*) omybuntu-toggle-idle ;;
  *"$I18N_TOG_NOTIFS"*) omybuntu-toggle-notification-silencing ;;
  *"$I18N_TOG_BAR"*) omybuntu-toggle-waybar ;;
  *"$I18N_TOG_LAYOUT"*) omybuntu-hyprland-workspace-layout-toggle ;;
  *"$I18N_TOG_RATIO"*) omybuntu-hyprland-window-single-square-aspect-toggle ;;
  *"$I18N_TOG_GAPS"*) omybuntu-hyprland-window-gaps-toggle ;;
  *"$I18N_TOG_SCALING"*) omybuntu-hyprland-monitor-scaling-cycle ;;
  *"$I18N_TOG_DIRECT_BOOT"*) present_terminal omybuntu-config-direct-boot ;;
  *"$I18N_TOG_SUDO"*) present_terminal omybuntu-sudo-passwordless ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_hardware_menu() {
  local options="$I18N_HW_DISPLAY\n$I18N_HW_MIRROR"

  if omybuntu-hw-hybrid-gpu; then
    options="$options\n$I18N_HW_GPU"
  fi

  if omybuntu-hw-touchpad; then
    options="$options\n$I18N_HW_TOUCHPAD"
  fi

  if omybuntu-hw-dell-xps-haptic-touchpad && omybuntu-cmd-present dell-xps-touchpad-haptics; then
    options="$options\n$I18N_HW_HAPTICS"
  fi

  if omybuntu-hw-touchscreen; then
    options="$options\n$I18N_HW_TOUCHSCREEN"
  fi

  case $(menu "$I18N_MENU_TOGGLE" "$options") in
  *"$I18N_HW_DISPLAY"*) omybuntu-hyprland-monitor-internal toggle ;;
  *"$I18N_HW_MIRROR"*) omybuntu-hyprland-monitor-internal-mirror toggle ;;
  *"$I18N_HW_HAPTICS"*) show_hardware_touchpad_haptics_menu ;;
  *"$I18N_HW_TOUCHPAD"*) omybuntu-toggle-touchpad ;;
  *"$I18N_HW_TOUCHSCREEN"*) omybuntu-toggle-touchscreen ;;
  *"$I18N_HW_GPU"*) present_terminal omybuntu-toggle-hybrid-gpu ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_hardware_touchpad_haptics_menu() {
  local current=$(dell-xps-touchpad-haptics get)
  local selected=$(menu "$I18N_HW_HAPTICS" "low\nmid\nhigh" "" "$current")

  if [[ -n $selected ]]; then
    dell-xps-touchpad-haptics set "$selected"
  else
    back_to show_hardware_menu
  fi
}

show_style_menu() {
  case $(menu "$I18N_MENU_STYLE" "$I18N_STY_THEME\n$I18N_STY_UNLOCK\n$I18N_STY_FONT\n$I18N_STY_BACKGROUND\n$I18N_STY_WAYBAR\n$I18N_STY_CORNERS\n$I18N_STY_CURSOR\n$I18N_STY_HYPRLAND\n$I18N_STY_SCREENSAVER\n$I18N_STY_ABOUT") in

  *"$I18N_STY_THEME"*) show_theme_menu ;;
  *"$I18N_STY_UNLOCK"*) omybuntu-launch-walker -m menus:omybuntuunlocks --width 800 --minheight 400 ;;
  *"$I18N_STY_FONT"*) show_font_menu ;;
  *"$I18N_STY_BACKGROUND"*) show_background_menu ;;
  *"$I18N_STY_CORNERS"*) show_style_corners_menu ;;
  *"$I18N_STY_CURSOR"*) show_style_cursor_menu ;;
  *"$I18N_STY_HYPRLAND"*) open_in_editor "$(hypr_config_file looknfeel)" ;;
  *"$I18N_STY_WAYBAR"*) show_waybar_position_menu ;;
  *"$I18N_STY_SCREENSAVER"*) show_screensaver_menu ;;
  *"$I18N_STY_ABOUT"*) show_about_menu ;;
  *) show_main_menu ;;
  esac
}

show_style_corners_menu() {
  case $(omybuntu-menu-select "$I18N_STY_CORNERS" "$I18N_CORNERS_SHARP" "$I18N_CORNERS_ROUND") in
  *"$I18N_CORNERS_SHARP"*) omybuntu-style-corners sharp ;;
  *"$I18N_CORNERS_ROUND"*) omybuntu-style-corners round ;;
  *) show_style_menu ;;
  esac
}

show_style_cursor_menu() {
  case $(omybuntu-menu-select "$I18N_STY_CURSOR" "$I18N_CURSOR_NORMAL" "$I18N_CURSOR_SLANTED") in
  *"$I18N_CURSOR_NORMAL"*) omybuntu-style-terminal-cursor normal ;;
  *"$I18N_CURSOR_SLANTED"*) omybuntu-style-terminal-cursor slanted ;;
  *) show_style_menu ;;
  esac
}

show_waybar_position_menu() {
  case $(menu "$I18N_STY_WAYBAR" "$I18N_WAYBAR_TOP\n$I18N_WAYBAR_BOTTOM\n$I18N_WAYBAR_LEFT\n$I18N_WAYBAR_RIGHT") in
  *"$I18N_WAYBAR_TOP"*) omybuntu-style-waybar-position top ;;
  *"$I18N_WAYBAR_BOTTOM"*) omybuntu-style-waybar-position bottom ;;
  *"$I18N_WAYBAR_LEFT"*) omybuntu-style-waybar-position left ;;
  *"$I18N_WAYBAR_RIGHT"*) omybuntu-style-waybar-position right ;;
  *) show_style_menu ;;
  esac
}

show_about_menu() {
  case $(menu "$I18N_STY_ABOUT" "$I18N_SUB_EDIT_TEXT\n$I18N_SUB_FROM_IMAGE\n$I18N_SUB_RESTORE") in
  *"$I18N_SUB_EDIT_TEXT"*) omybuntu-branding-about text ;;
  *"$I18N_SUB_FROM_IMAGE"*) omybuntu-branding-about image ;;
  *"$I18N_SUB_RESTORE"*) omybuntu-branding-about reset ;;
  *) show_style_menu ;;
  esac
}

show_screensaver_menu() {
  case $(menu "$I18N_STY_SCREENSAVER" "$I18N_SUB_EDIT_TEXT\n$I18N_SUB_FROM_IMAGE\n$I18N_SUB_RESTORE") in
  *"$I18N_SUB_EDIT_TEXT"*) omybuntu-branding-screensaver text ;;
  *"$I18N_SUB_FROM_IMAGE"*) omybuntu-branding-screensaver image ;;
  *"$I18N_SUB_RESTORE"*) omybuntu-branding-screensaver reset ;;
  *) show_style_menu ;;
  esac
}

show_theme_menu() {
  theme=$(omybuntu-theme-switcher)
  [[ -n $theme ]] && omybuntu-theme-set "$theme"
}

show_background_menu() {
  background=$(omybuntu-theme-bg-switcher)
  [[ -n $background ]] && omybuntu-theme-bg-set "$background"
}

show_font_menu() {
  theme=$(menu "$I18N_STY_FONT" "$(omybuntu-font-list)" "--width 350" "$(omybuntu-font-current)")
  if [[ $theme == "CNCLD" || -z $theme ]]; then
    back_to show_style_menu
  else
    omybuntu-font-set "$theme"
  fi
}

show_setup_menu() {
  local options="$I18N_SET_AUDIO\n$I18N_SET_WIFI\n$I18N_SET_BLUETOOTH\n$I18N_SET_POWER\n$I18N_SET_SLEEP\n$I18N_SET_MONITORS"
  [[ -f ~/.config/hypr/bindings.conf ]] && options="$options\n$I18N_SET_KEYBINDINGS"
  [[ -f ~/.config/hypr/input.conf ]] && options="$options\n$I18N_SET_INPUT"
  options="$options\n$I18N_SET_DEFAULTS\n$I18N_SET_DNS\n$I18N_SET_SECURITY\n$I18N_SET_CONFIG\n$I18N_SET_LANGUAGE"

  case $(menu "$I18N_MENU_SETUP" "$options") in
  *"$I18N_SET_AUDIO"*) omybuntu-launch-audio ;;
  *"$I18N_SET_WIFI"*) omybuntu-launch-wifi ;;
  *"$I18N_SET_BLUETOOTH"*) omybuntu-launch-bluetooth ;;
  *"$I18N_SET_POWER"*) show_setup_power_menu ;;
  *"$I18N_SET_SLEEP"*) show_setup_system_menu ;;
  *"$I18N_SET_MONITORS"*) open_in_editor "$(hypr_config_file monitors)" ;;
  *"$I18N_SET_KEYBINDINGS"*) open_in_editor "$(hypr_config_file bindings)" ;;
  *"$I18N_SET_INPUT"*) open_in_editor "$(hypr_config_file input)" ;;
  *"$I18N_SET_DEFAULTS"*) show_setup_default_menu ;;
  *"$I18N_SET_DNS"*) present_terminal omybuntu-setup-dns ;;
  *"$I18N_SET_SECURITY"*) show_setup_security_menu ;;
  *"$I18N_SET_CONFIG"*) show_setup_config_menu ;;
  *"$I18N_SET_LANGUAGE"*) show_language_menu ;;
  *) show_main_menu ;;
  esac
}

show_setup_power_menu() {
  local current
  current=$(powerprofilesctl get)

  local options=""
  local list
  mapfile -t list < <(omybuntu-powerprofiles-list)

  for p in "${list[@]}"; do
    if [[ $p == "$current" ]]; then
      options+="${options:+$'\n'}●  $p"
    else
      options+="${options:+$'\n'}○  $p"
    fi
  done

  local selected
  selected=$(menu "$I18N_SET_POWER" "$options" "" "●  $current")

  if [[ $selected == "CNCLD" || -z $selected ]]; then
    back_to show_setup_menu
  else
    local profile
    profile="${selected#*  }"
    powerprofilesctl set "$profile"
  fi
}

show_setup_security_menu() {
  case $(menu "$I18N_MENU_SETUP" "$I18N_SEC_FINGERPRINT\n$I18N_SEC_FIDO2") in
  *"$I18N_SEC_FINGERPRINT"*) present_terminal omybuntu-setup-security-fingerprint ;;
  *"$I18N_SEC_FIDO2"*) present_terminal omybuntu-setup-security-fido2 ;;
  *) show_setup_menu ;;
  esac
}

show_setup_default_menu() {
  case $(menu "$I18N_SET_DEFAULTS" "$I18N_DEFAULTS_BROWSER\n$I18N_DEFAULTS_TERMINAL\n$I18N_DEFAULTS_EDITOR") in
  *"$I18N_DEFAULTS_BROWSER"*) show_setup_default_browser_menu ;;
  *"$I18N_DEFAULTS_TERMINAL"*) show_setup_default_terminal_menu ;;
  *"$I18N_DEFAULTS_EDITOR"*) show_setup_default_editor_menu ;;
  *) show_setup_menu ;;
  esac
}

browser_desktop_exists() {
  [[ -f ~/.local/share/applications/$1 || -f ~/.nix-profile/share/applications/$1 || -f /usr/share/applications/$1 ]]
}

show_setup_default_browser_menu() {
  local options=""
  browser_desktop_exists chromium.desktop && options="$options  Chromium"
  browser_desktop_exists google-chrome.desktop && options="${options:+$options\n}󰊯  Chrome"
  browser_desktop_exists brave-browser.desktop && options="${options:+$options\n}󰖟  Brave"
  browser_desktop_exists brave-origin-beta.desktop && options="${options:+$options\n}󰖟  Brave Origin"
  browser_desktop_exists microsoft-edge.desktop && options="${options:+$options\n}󰇩  Edge"
  browser_desktop_exists firefox.desktop && options="${options:+$options\n}󰈹  Firefox"
  browser_desktop_exists zen.desktop && options="${options:+$options\n}󰖟  Zen"

  local current=""
  case "$(omybuntu-default-browser)" in
  chromium) current="  Chromium" ;;
  chrome) current="󰊯  Chrome" ;;
  brave) current="󰖟  Brave" ;;
  brave-origin) current="󰖟  Brave Origin" ;;
  edge) current="󰇩  Edge" ;;
  firefox) current="󰈹  Firefox" ;;
  zen) current="󰖟  Zen" ;;
  esac

  case $(menu "$I18N_SET_DEFAULT_BROWSER" "$options" "" "$current") in
  *Chromium*) omybuntu-default-browser chromium ;;
  *Chrome*) omybuntu-default-browser chrome ;;
  *"Brave Origin"*) omybuntu-default-browser brave-origin ;;
  *Brave*) omybuntu-default-browser brave ;;
  *Edge*) omybuntu-default-browser edge ;;
  *Firefox*) omybuntu-default-browser firefox ;;
  *Zen*) omybuntu-default-browser zen ;;
  *) show_setup_default_menu ;;
  esac
}

show_setup_default_terminal_menu() {
  local options=""
  omybuntu-cmd-present alacritty && options="$options  Alacritty"
  omybuntu-cmd-present foot && options="${options:+$options\n}  Foot"
  omybuntu-cmd-present ghostty && options="${options:+$options\n}  Ghostty"
  omybuntu-cmd-present kitty && options="${options:+$options\n}  Kitty"

  local current=""
  case "$(omybuntu-default-terminal)" in
  alacritty) current="  Alacritty" ;;
  foot) current="  Foot" ;;
  ghostty) current="  Ghostty" ;;
  kitty) current="  Kitty" ;;
  esac

  case $(menu "$I18N_SET_DEFAULT_TERMINAL" "$options" "" "$current") in
  *Alacritty*) omybuntu-default-terminal alacritty ;;
  *Foot*) omybuntu-default-terminal foot ;;
  *Ghostty*) omybuntu-default-terminal ghostty ;;
  *Kitty*) omybuntu-default-terminal kitty ;;
  *) show_setup_default_menu ;;
  esac
}

show_setup_default_editor_menu() {
  local options=""
  omybuntu-cmd-present nvim && options="$options  Neovim"
  omybuntu-cmd-present code && options="${options:+$options\n}  VSCode"
  omybuntu-cmd-present cursor && options="${options:+$options\n}  Cursor"
  omybuntu-cmd-present zeditor && options="${options:+$options\n}  Zed"
  omybuntu-cmd-present sublime_text && options="${options:+$options\n}  Sublime Text"
  omybuntu-cmd-present helix && options="${options:+$options\n}  Helix"
  omybuntu-cmd-present vim && options="${options:+$options\n}  Vim"
  omybuntu-cmd-present emacs && options="${options:+$options\n}  Emacs"

  local current=""
  case "$(omybuntu-default-editor)" in
  nvim) current="  Neovim" ;;
  code) current="  VSCode" ;;
  cursor) current="  Cursor" ;;
  zed | zeditor) current="  Zed" ;;
  sublime_text) current="  Sublime Text" ;;
  helix) current="  Helix" ;;
  vim) current="  Vim" ;;
  emacs) current="  Emacs" ;;
  esac

  case $(menu "$I18N_SET_DEFAULT_EDITOR" "$options" "" "$current") in
  *Neovim*) omybuntu-default-editor nvim ;;
  *VSCode*) omybuntu-default-editor code ;;
  *Cursor*) omybuntu-default-editor cursor ;;
  *Zed*) omybuntu-default-editor zed ;;
  *Sublime*) omybuntu-default-editor sublime_text ;;
  *Helix*) omybuntu-default-editor helix ;;
  *Vim*) omybuntu-default-editor vim ;;
  *Emacs*) omybuntu-default-editor emacs ;;
  *) show_setup_default_menu ;;
  esac
}

show_setup_config_menu() {
  case $(menu "$I18N_MENU_SETUP" "  Hyprland\n  Hypridle\n  Hyprlock\n  Hyprsunset\n  Swayosd\n󰌧  Walker\n󰍜  Waybar\n󰞅  XCompose") in
  *Hyprland*) open_in_editor "$(hypr_config_file hyprland)" ;;
  *Hypridle*) open_in_editor ~/.config/hypr/hypridle.conf && omybuntu-restart-hypridle ;;
  *Hyprlock*) open_in_editor ~/.config/hypr/hyprlock.conf ;;
  *Hyprsunset*) open_in_editor ~/.config/hypr/hyprsunset.conf && omybuntu-restart-hyprsunset ;;
  *Swayosd*) open_in_editor ~/.config/swayosd/config.toml && omybuntu-restart-swayosd ;;
  *Walker*) open_in_editor ~/.config/walker/config.toml && omybuntu-restart-walker ;;
  *Waybar*) open_in_editor ~/.config/waybar/config.jsonc && omybuntu-restart-waybar ;;
  *XCompose*) open_in_editor ~/.XCompose && omybuntu-restart-xcompose ;;
  *) show_setup_menu ;;
  esac
}

show_setup_system_menu() {
  local options=""

  if omybuntu-toggle-enabled suspend-off; then
    options="$options$I18N_SYS_ENABLE_SUSPEND"
  else
    options="$options$I18N_SYS_DISABLE_SUSPEND"
  fi

  if omybuntu-hibernation-available; then
    options="$options\n$I18N_SYS_DISABLE_HIBERNATE"
  else
    options="$options\n$I18N_SYS_ENABLE_HIBERNATE"
  fi

  case $(menu "$I18N_MENU_SYSTEM" "$options") in
  *Suspen*) omybuntu-toggle-suspend ;;
  *"$I18N_SYS_ENABLE_HIBERNATE"*) present_terminal omybuntu-hibernation-setup ;;
  *"$I18N_SYS_DISABLE_HIBERNATE"*) present_terminal omybuntu-hibernation-remove ;;
  *) show_setup_menu ;;
  esac
}

