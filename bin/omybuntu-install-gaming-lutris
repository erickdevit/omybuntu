#!/bin/bash

# omybuntu:summary=Install Lutris with Wine + DXVK for running Windows games (Battle.net, EA, Ubisoft Connect, etc.)
# omybuntu:requires-sudo=true

set -euo pipefail
trap 'echo -e "\n❌ Error: Installation failed at line $LINENO." >&2' ERR

echo "Installing Lutris..."
omybuntu-pkg-add lutris wine winetricks python3-protobuf
omybuntu-install-gaming-gpu-lib32

# Lutris ships with `#!/usr/bin/env python3`, which resolves to mise's Python and
# fails to import the lutris module. Pin the shebang to the system Python.
sudo sed -i 's|^#!/usr/bin/env python3|#!/usr/bin/python3|g' /usr/bin/lutris

cat <<'EOF'

Lutris will open and auto-fetch its DXVK and VKD3D runtimes in the background
(watch the bottom status bar). Once that finishes, click the + to add or install games.

EOF

setsid lutris >/dev/null 2>&1 &

echo "✅ Success: Lutris installed."
