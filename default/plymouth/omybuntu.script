# Omybuntu Plymouth Theme Script

Window.SetBackgroundTopColor(0.078, 0.039, 0.020);
Window.SetBackgroundBottomColor(0.078, 0.039, 0.020);

# Keep the themed logo for the disk-unlock prompt. Normal boot uses the
# distro icon spinner below instead.
logo.original_image = Image("logo.png");
logo.max_width = Math.Int(Window.GetWidth() * 0.44);
if (logo.max_width > 520) logo.max_width = 520;
if (logo.original_image.GetWidth() > logo.max_width) {
  logo.width = logo.max_width;
  logo.height = Math.Int(logo.original_image.GetHeight() * logo.width / logo.original_image.GetWidth());
  logo.image = logo.original_image.Scale(logo.width, logo.height);
} else {
  logo.image = logo.original_image;
}
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetOpacity(0);

# Scale the square spinner from the shortest screen dimension. The bounds keep
# it readable at low resolutions without becoming oversized on HiDPI displays.
spinner.original_image = Image("spinner.png");
spinner.size = Math.Int(Window.GetHeight() * 0.18);
if (Window.GetWidth() < Window.GetHeight()) {
  spinner.size = Math.Int(Window.GetWidth() * 0.18);
}
if (spinner.size < 96) spinner.size = 96;
if (spinner.size > 320) spinner.size = 320;
spinner.image = spinner.original_image.Scale(spinner.size, spinner.size);

# Plymouth refreshes at 50 FPS. One turn therefore takes one second, followed
# by two more turns and a short 0.4 second pause before the cycle repeats.
spinner.frame_count = 50;
spinner.turns_per_cycle = 3;
spinner.pause_frames = 20;
spinner.frames = [];
for (index = 0; index < spinner.frame_count; index++) {
  # Positive angles rotate clockwise in Plymouth's screen coordinate system.
  angle = Math.Pi * 2 * index / spinner.frame_count;
  spinner.frames[index] = spinner.image.Rotate(angle);
}

spinner.sprite = Sprite(spinner.frames[0]);
spinner.sprite.SetPosition(
  Window.GetWidth() / 2 - spinner.frames[0].GetWidth() / 2,
  Window.GetHeight() / 2 - spinner.frames[0].GetHeight() / 2,
  10
);
spinner.sprite.SetOpacity(0);

global.spinner_active = 0;
global.spinner_frame = 0;
global.spinner_turn = 0;
global.spinner_pause_frame = 0;

fun center_spinner(image) {
  spinner.sprite.SetPosition(
    Window.GetWidth() / 2 - image.GetWidth() / 2,
    Window.GetHeight() / 2 - image.GetHeight() / 2,
    10
  );
}

fun reset_spinner() {
  global.spinner_frame = 0;
  global.spinner_turn = 0;
  global.spinner_pause_frame = 0;
  spinner.sprite.SetImage(spinner.frames[0]);
  center_spinner(spinner.frames[0]);
}

fun start_spinner() {
  reset_spinner();
  global.spinner_active = 1;
  spinner.sprite.SetOpacity(1);
}

fun stop_spinner() {
  global.spinner_active = 0;
  reset_spinner();
  spinner.sprite.SetOpacity(0);
}

fun refresh_callback() {
  if (global.spinner_active == 1) {
    if (global.spinner_turn < spinner.turns_per_cycle) {
      frame = spinner.frames[global.spinner_frame];
      spinner.sprite.SetImage(frame);
      center_spinner(frame);

      global.spinner_frame++;
      if (global.spinner_frame >= spinner.frame_count) {
        global.spinner_frame = 0;
        global.spinner_turn++;
      }
    } else {
      # Hold the icon upright during the pause between three-turn cycles.
      spinner.sprite.SetImage(spinner.frames[0]);
      center_spinner(spinner.frames[0]);
      global.spinner_pause_frame++;

      if (global.spinner_pause_frame >= spinner.pause_frames) {
        global.spinner_turn = 0;
        global.spinner_pause_frame = 0;
      }
    }
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

#----------------------------------------- Dialogue --------------------------------

lock.image = Image("lock.png");
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");

entry.sprite = Sprite(entry.image);
entry.x = Window.GetWidth() / 2 - entry.image.GetWidth() / 2;
entry.y = logo.sprite.GetY() + logo.image.GetHeight() + 96;
entry.sprite.SetPosition(entry.x, entry.y, 10001);
entry.sprite.SetOpacity(0);

# Scale lock to be slightly shorter than entry field height
# Original lock is 84x96, entry height determines scale
lock_height = entry.image.GetHeight() * 0.8;
lock_scale = lock_height / 96;
lock_width = 84 * lock_scale;

scaled_lock = lock.image.Scale(lock_width, lock_height);
lock.sprite = Sprite(scaled_lock);
lock.x = entry.x - lock_width - 15;
lock.y = entry.y + entry.image.GetHeight() / 2 - lock_height / 2;
lock.sprite.SetPosition(lock.x, lock.y, 10001);
lock.sprite.SetOpacity(0);

bullet.sprites = [];

fun show_password_dialog() {
  stop_spinner();
  logo.sprite.SetOpacity(1);
  lock.sprite.SetOpacity(1);
  entry.sprite.SetOpacity(1);
}

fun hide_password_dialog() {
  logo.sprite.SetOpacity(0);
  lock.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(0);

  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }
}

fun display_normal_callback() {
  hide_password_dialog();

  mode = Plymouth.GetMode();
  if (mode == "boot" || mode == "resume") {
    start_spinner();
  }
}

fun display_password_callback(prompt, bullets) {
  show_password_dialog();

  for (index = 0; bullet.sprites[index]; index++) {
    bullet.sprites[index].SetOpacity(0);
  }

  max_bullets = 21;
  bullets_to_show = bullets;
  if (bullets_to_show > max_bullets) {
    bullets_to_show = max_bullets;
  }

  for (index = 0; index < bullets_to_show; index++) {
    if (!bullet.sprites[index]) {
      scaled_bullet = bullet.image.Scale(7, 7);
      bullet.sprites[index] = Sprite(scaled_bullet);
      bullet.x = entry.x + 20 + index * (7 + 5);
      bullet.y = entry.y + entry.image.GetHeight() / 2 - 3.5;
      bullet.sprites[index].SetPosition(bullet.x, bullet.y, 10002);
    }

    bullet.sprites[index].SetOpacity(1);
  }
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

initial_mode = Plymouth.GetMode();
if (initial_mode == "boot" || initial_mode == "resume") {
  start_spinner();
}

#----------------------------------------- Message --------------------------------

message_sprite = Sprite();
message_sprite.SetPosition(10, 10, 10000);

fun display_message_callback(text) {
  message = Image.Text(text, 1, 1, 1);
  message_sprite.SetImage(message);
  message_sprite.SetOpacity(1);
}

fun hide_message_callback(text) {
  message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

#----------------------------------------- Quit ------------------------------------

fun quit_callback() {
  stop_spinner();
}

Plymouth.SetQuitFunction(quit_callback);
