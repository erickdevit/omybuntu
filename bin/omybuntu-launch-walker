#!/bin/bash

# omybuntu:summary=Launch Walker and ensure its Elephant data provider is running

if ! pgrep -f "/home/erick/.local/bin/elephant" > /dev/null; then
  setsid uwsm-app -- /home/erick/.local/bin/elephant &
fi

# Ensure walker service is running
if ! pgrep -f "/home/erick/.local/bin/walker --gapplication-service" > /dev/null; then
  setsid uwsm-app -- env GSK_RENDERER=cairo /home/erick/.local/bin/walker --gapplication-service &
fi

exec /home/erick/.local/bin/walker --width 504 --maxheight 300 --minheight 300 "$@"
