#!/bin/bash

# omybuntu:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if pactl get-source-mute @DEFAULT_SOURCE@ | rg -q 'yes'; then
  led=on
  osd_message="$I18N_OSD_MIC_MUTED"
  osd_icon='microphone-sensitivity-muted-symbolic'
else
  led=off
  osd_message="$I18N_OSD_MIC_ON"
  osd_icon='audio-input-microphone-symbolic'
fi

omybuntu-brightness-keyboard-mute "$led"

omybuntu-swayosd-client \
  --custom-message "$osd_message" \
  --custom-icon "$osd_icon"
