#!/bin/bash

# omybuntu:summary=Install Steam and graphics drivers selected for this system
# omybuntu:requires-sudo=true

set -e

echo "Installing Steam..."
omybuntu-pkg-add steam
omybuntu-install-gaming-gpu-lib32

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid gtk-launch steam >/dev/null 2>&1 &
