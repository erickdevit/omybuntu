#!/bin/bash

# omybuntu:summary=Launch the default browser as determined by xdg-settings.
# omybuntu:args=[url]

default_browser=$(xdg-settings get default-web-browser)
browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' \
  ~/.local/share/applications/"$default_browser" \
  ~/.local/share/flatpak/exports/share/applications/"$default_browser" \
  ~/.nix-profile/share/applications/"$default_browser" \
  /usr/share/applications/"$default_browser" \
  /usr/local/share/applications/"$default_browser" \
  /var/lib/flatpak/exports/share/applications/"$default_browser" \
  /var/lib/snapd/desktop/applications/"$default_browser" 2>/dev/null | head -1)

if $browser_exec --help 2>/dev/null | grep -q MOZ_LOG; then
  private_flag="--private-window"
elif [[ $browser_exec =~ edge ]]; then
  private_flag="--inprivate"
else
  private_flag="--incognito"
fi

# Determine flags file based on browser executable
flags_file=""
if [[ $browser_exec =~ chrome ]]; then
  flags_file="$HOME/.config/chrome-flags.conf"
elif [[ $browser_exec =~ brave-browser-beta ]]; then
  flags_file="$HOME/.config/brave-origin-beta-flags.conf"
elif [[ $browser_exec =~ brave ]]; then
  flags_file="$HOME/.config/brave-flags.conf"
elif [[ $browser_exec =~ edge ]]; then
  flags_file="$HOME/.config/microsoft-edge-stable-flags.conf"
elif [[ $browser_exec =~ chromium ]]; then
  flags_file="$HOME/.config/chromium-flags.conf"
fi

extra_args=()
if [[ -n $flags_file && -f $flags_file ]]; then
  while read -r line; do
    [[ $line =~ ^# ]] || [[ -z $line ]] && continue
    # Expand ~ to $HOME
    line="${line//\~/$HOME}"
    extra_args+=("$line")
  done < "$flags_file"
fi

systemd-run --user --quiet --collect --unit="omybuntu-browser-$(date +%s%N)" \
  --property=StandardOutput=null --property=StandardError=null \
  uwsm-app -- "$browser_exec" "${extra_args[@]}" "${@/--private/$private_flag}"
