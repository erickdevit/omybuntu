#!/bin/bash

# omybuntu:summary=Toggle the layout on the current active workspace between dwindle and scrolling

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

ACTIVE_WORKSPACE_JSON=$(hyprctl activeworkspace -j)
ACTIVE_WORKSPACE=$(jq -r '.id' <<<"$ACTIVE_WORKSPACE_JSON")
CURRENT_LAYOUT=$(jq -r '.tiledLayout // empty' <<<"$ACTIVE_WORKSPACE_JSON")
STATE_DIR="$HOME/.local/state/omybuntu/workspace-layouts"
STATE_FILE="$STATE_DIR/$ACTIVE_WORKSPACE"

if [[ -z $CURRENT_LAYOUT && -f $STATE_FILE ]]; then
  CURRENT_LAYOUT=$(<"$STATE_FILE")
fi

if [[ -z $CURRENT_LAYOUT ]]; then
  CURRENT_LAYOUT=$(hyprctl getoption general:layout -j | jq -r '.str // "dwindle"')
fi

case "$CURRENT_LAYOUT" in
  dwindle) NEW_LAYOUT=scrolling ;;
  *) NEW_LAYOUT=dwindle ;;
esac

if ! hyprctl eval "hl.workspace_rule({ workspace = \"$ACTIVE_WORKSPACE\", layout = \"$NEW_LAYOUT\" })" >/dev/null 2>&1; then
  hyprctl keyword workspace "$ACTIVE_WORKSPACE, layout:$NEW_LAYOUT"
fi

mkdir -p "$STATE_DIR"
echo "$NEW_LAYOUT" > "$STATE_FILE"
omybuntu-notification-send -g 󱂬 "$(printf "$I18N_LAYOUT_SET" "$NEW_LAYOUT")"
