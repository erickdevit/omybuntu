#!/bin/bash

# omybuntu:summary=Select a drive from a list with info that includes space and brand. Used by omybuntu-drive-password.

if (($# == 0)); then
  drives=$(lsblk -dpno NAME | grep -E '/dev/(sd|hd|vd|nvme|mmcblk|xv)')
else
  drives="$@"
fi

drives_with_info=""
while IFS= read -r drive; do
  [[ -n $drive ]] || continue
  drives_with_info+="$(omybuntu-drive-info "$drive")"$'\n'
done <<<"$drives"

source "${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}/default/i18n/init.sh"

selected_drive="$(printf "%s" "$drives_with_info" | gum choose --header "$I18N_DRIVE_SELECT_HEADER")" || exit 1
printf "%s\n" "$selected_drive" | awk '{print $1}'
