#!/bin/bash

# omybuntu:summary=Install the Tailscale mesh VPN service and a web app for the Tailscale Admin Console.
# omybuntu:requires-sudo=true

set -euo pipefail
trap 'echo -e "\n❌ Error: Installation failed at line $LINENO." >&2' ERR

echo -e "\nInstalling Tailscale..."
curl -fsSL https://tailscale.com/install.sh | sh

echo -e "\nStarting Tailscale..."
sudo systemctl enable --now tailscaled.service
sudo tailscale up --accept-routes

omybuntu-webapp-install "Tailscale" "https://login.tailscale.com/admin/machines" https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/tailscale-light.png

echo -e "\n✅ Success: Tailscale installed."
