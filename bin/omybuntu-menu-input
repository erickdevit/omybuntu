#!/bin/bash

# omybuntu:summary=Prompt for text input with Walker
# omybuntu:group=menu
# omybuntu:name=input
# omybuntu:args=prompt [walker args...]
# omybuntu:examples=omybuntu menu input Reminder|omybuntu-menu-input "Reminder in minutes" --width 400

set -euo pipefail

prompt="${1:-Input}"
if (( $# > 0 )); then
  shift
fi

omybuntu-launch-walker --dmenu --inputonly --width 295 --minheight 1 --maxheight 1 -p "$prompt…" "$@" 2>/dev/null
