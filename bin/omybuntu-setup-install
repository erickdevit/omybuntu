#!/bin/bash

# omybuntu:summary=Omybuntu system installer (TUI wizard)
# omybuntu:group=setup
# omybuntu:requires-sudo=true

OMYBUNTU_PATH="$(dirname "$(dirname "$(readlink -f "$0")")")"

if [[ -x /usr/local/bin/omybuntu-installer ]]; then
  /usr/local/bin/omybuntu-installer "$@"
  exit_code=$?
  if [[ $exit_code -eq 0 ]]; then
    exit 0
  fi
  echo "TUI installer failed (exit $exit_code). Falling back to install.sh..." >&2
else
  echo "TUI installer not found. Using install.sh..." >&2
fi

# Fallback: run install.sh (configures existing Ubuntu system)
exec sudo bash "$OMYBUNTU_PATH/install.sh"
