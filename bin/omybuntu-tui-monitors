#!/bin/bash

# omybuntu:summary=Clean and complete TUI for monitor management

set -euo pipefail

OMYBUNTU_PATH="${OMYBUNTU_PATH:-$HOME/.local/share/omybuntu}"

# Search order:
# 1. /usr/local/bin/omybuntu-tui-monitors
# 2. $OMYBUNTU_PATH/installer/target/release/omybuntu-tui-monitors
# 3. Compile dynamically and run the debug build

BINARY=""
if [[ -x /usr/local/bin/omybuntu-tui-monitors ]]; then
  BINARY="/usr/local/bin/omybuntu-tui-monitors"
elif [[ -x "$OMYBUNTU_PATH/installer/target/release/omybuntu-tui-monitors" ]]; then
  BINARY="$OMYBUNTU_PATH/installer/target/release/omybuntu-tui-monitors"
elif [[ -x "$OMYBUNTU_PATH/installer/target/debug/omybuntu-tui-monitors" ]]; then
  BINARY="$OMYBUNTU_PATH/installer/target/debug/omybuntu-tui-monitors"
else
  # Compile on the fly
  echo "Compiling monitors TUI..."
  cargo build --manifest-path "$OMYBUNTU_PATH/installer/Cargo.toml" --bin omybuntu-tui-monitors
  BINARY="$OMYBUNTU_PATH/installer/target/debug/omybuntu-tui-monitors"
fi

exec "$BINARY" "$@"
